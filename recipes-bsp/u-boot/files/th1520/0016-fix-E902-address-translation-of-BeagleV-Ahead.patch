From 9b38901614c34066055eb537e1354a0a2c34cee2 Mon Sep 17 00:00:00 2001
From: Adn Elkawass <elkawasadn@gmail.com>
Date: Wed, 30 Sep 2026 08:01:19 +0300
Subject: [PATCH 16/16] fix E902 address translation of BeagleV-Ahead

Signed-off-by: Adn Elkawass <elkawasadn@gmail.com>
Upstream-Status: Pending

---
 drivers/remoteproc/thead_th1520_rproc.c | 24 ++++++++++++++++++------
 1 file changed, 18 insertions(+), 6 deletions(-)

diff --git a/drivers/remoteproc/thead_th1520_rproc.c b/drivers/remoteproc/thead_th1520_rproc.c
index 4d6cbed1339..665e40bd6d9 100644
--- a/drivers/remoteproc/thead_th1520_rproc.c
+++ b/drivers/remoteproc/thead_th1520_rproc.c
@@ -17,16 +17,28 @@ struct th1520_rproc_priv {
 };
 
 #define TH1520_E902_RST_ADDR		0x44
+#define TH1520_E902_DA_BASE		0xffef8000UL
+#define TH1520_E902_CPU_BASE		0xffffef8000UL
+#define TH1520_E902_SRAM_SIZE		0x10000UL
 
 static void *th1520_rproc_device_to_virt(struct udevice *dev, ulong da,
-                                         ulong size, bool *is_iomem)
+					 ulong size, bool *is_iomem)
 {
-        if (is_iomem)
-                *is_iomem = true;
-	if (da >= 0xffef8000 && da <= 0xfff40000)
-		return (void __iomem *)0xffffef8000;
+	ulong offset;
 
-	return NULL;
+	if (da < TH1520_E902_DA_BASE ||
+	    da >= TH1520_E902_DA_BASE + TH1520_E902_SRAM_SIZE)
+		return NULL;
+
+	offset = da - TH1520_E902_DA_BASE;
+
+	if (size > TH1520_E902_SRAM_SIZE - offset)
+		return NULL;
+
+	if (is_iomem)
+		*is_iomem = true;
+
+	return (void __iomem *)(TH1520_E902_CPU_BASE + offset);
 }
 
 static int th1520_rproc_load(struct udevice *dev, ulong addr, ulong size)
-- 
