From 152a2464ca35f46fcb07ab3064202f3f17477b25 Mon Sep 17 00:00:00 2001
From: Adn Elkawass <elkawasadn@gmail.com>
Date: Wed, 30 Sep 2026 00:10:53 +0300
Subject: [PATCH] start AON firmware before boot in BeagleV-Ahead

Start the TH1520 E902 AON firmware from preboot before continuing with
the normal BeagleV-Ahead boot flow.

Load the firmware from the SD card first (mmc 1), with eMMC (mmc 0) as
a fallback. Use U-Boot's filesystem-agnostic load command instead of
hard-coding ext4load.

Upstream-Status: Pending [not submitted upstream]
Signed-off-by: Adn Elkawass <elkawasadn@gmail.com>
---
 configs/th1520_beaglev_ahead_defconfig | 1 +
 include/configs/th1520_beaglev_ahead.h | 4 ++++
 2 files changed, 5 insertions(+)

diff --git a/configs/th1520_beaglev_ahead_defconfig b/configs/th1520_beaglev_ahead_defconfig
index 8b45de13b96..d41fa010ca9 100644
--- a/configs/th1520_beaglev_ahead_defconfig
+++ b/configs/th1520_beaglev_ahead_defconfig
@@ -26,6 +26,7 @@ CONFIG_BOOTSTD_FULL=y
 CONFIG_DISTRO_DEFAULTS=y
 CONFIG_BOOTARGS_SUBST=y
 CONFIG_BOOTCOMMAND=""
+CONFIG_USE_PREBOOT=y
 CONFIG_DEFAULT_FDT_FILE="thead/th1520-beaglev-ahead.dtb"
 CONFIG_SYS_CBSIZE=256
 CONFIG_SYS_PBSIZE=276
diff --git a/include/configs/th1520_beaglev_ahead.h b/include/configs/th1520_beaglev_ahead.h
index 4372b741d89..b7a37c63113 100644
--- a/include/configs/th1520_beaglev_ahead.h
+++ b/include/configs/th1520_beaglev_ahead.h
@@ -18,6 +18,10 @@
 	"kernel_addr_r=0x31000000\0" \
 	"ramdisk_addr_r=0x34000000\0" \
 	"fdt_addr_r=0x40000000\0" \
+	"aon_addr_r=0x80200000\0" \
+	/* mmc 1 is SD; mmc 0 is the eMMC fallback. */ \
+	"aon_boot=echo Starting TH1520 AON E902...; rproc init; if load mmc 1:1 ${aon_addr_r} /beaglev-ahead-aon.elf || load mmc 0:1 ${aon_addr_r} /beaglev-ahead-aon.elf; then if rproc load 0 ${aon_addr_r} ${filesize}; then rproc start 0; fi; else echo AON firmware not found; fi\0" \
+	"preboot=run aon_boot\0" \
 	"PS1=[BeagleVAhead]# \0"
 
 #endif /* __TH1520_BEAGLEV_AHEAD_H */
-- 
