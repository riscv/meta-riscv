 obj-$(CONFIG_REMOTEPROC_RENESAS_RSIP) += renesas_rsip.o
 obj-$(CONFIG_REMOTEPROC_SANDBOX) += sandbox_testproc.o
 obj-$(CONFIG_REMOTEPROC_STM32_COPRO) += stm32_copro.o
