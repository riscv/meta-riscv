# short-description: Create an SD card image for the Xunlong Orange Pi RV
# long-description:
# SPL, OpenSBI and U-Boot are loaded from the on-board QSPI flash. U-Boot
# standard boot finds the EFI System Partition, loads /dtb/${fdtfile} from it
# and starts GRUB, which boots Linux with that device tree.
#
# The disk layout used is:
#  - ------------------ --------------
# | | /boot (ESP, vfat) |    rootfs    |
#  - ------------------ --------------
# ^ ^                   ^
# | |                   |
# 0 1MiB              293MiB
#
part /boot --source bootimg_efi --sourceparams="loader=grub-efi" --ondisk mmcblk --label boot --active --part-name boot --part-type C12A7328-F81F-11D2-BA4B-00A0C93EC93B --align 1024 --size 292M

part / --source rootfs --ondisk mmcblk --fstype=ext4 --part-name root --part-type 0FC63DAF-8483-4772-8E79-3D69D8477DE4 --label root --align 1024

bootloader --ptable gpt --timeout 3 --append "console=ttyS0,115200 earlycon=sbi"
