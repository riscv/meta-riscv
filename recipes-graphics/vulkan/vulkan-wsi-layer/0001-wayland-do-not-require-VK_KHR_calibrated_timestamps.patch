From aeb8c739ba53582942d1f9cf3a5dc2483466f233 Mon Sep 17 00:00:00 2001
From: OOHehir <40183643+OOHehir@users.noreply.github.com>
Date: Fri, 23 Oct 2026 13:28:32 +0100
Subject: [PATCH 1/3] wayland: do not require VK_KHR_calibrated_timestamps

The extension is only used for VK_EXT_present_timing, but the Wayland backend
requires it for every swapchain, so ICDs without it, such as the PowerVR 1.19
DDK on the StarFive JH7110, cannot present at all.

Upstream-Status: Inappropriate [disable feature]

Signed-off-by: OOHehir <40183643+OOHehir@users.noreply.github.com>
---
 wsi/wayland/surface_properties.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/wsi/wayland/surface_properties.cpp b/wsi/wayland/surface_properties.cpp
index 366e262..0ca0dd4 100644
--- a/wsi/wayland/surface_properties.cpp
+++ b/wsi/wayland/surface_properties.cpp
@@ -273,7 +273,7 @@ VkResult surface_properties::get_required_device_extensions(util::extension_list
    const std::array required_device_extensions{
       VK_EXT_IMAGE_DRM_FORMAT_MODIFIER_EXTENSION_NAME, VK_KHR_IMAGE_FORMAT_LIST_EXTENSION_NAME,
       VK_EXT_EXTERNAL_MEMORY_DMA_BUF_EXTENSION_NAME,   VK_KHR_EXTERNAL_MEMORY_FD_EXTENSION_NAME,
-      VK_KHR_EXTERNAL_FENCE_FD_EXTENSION_NAME,         VK_KHR_CALIBRATED_TIMESTAMPS_EXTENSION_NAME,
+      VK_KHR_EXTERNAL_FENCE_FD_EXTENSION_NAME,
    };
    result = extension_list.add(required_device_extensions.data(), required_device_extensions.size());
    if (result != VK_SUCCESS)
