From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Thomas Roos <thomas@exein.io>
Date: Thu, 5 Nov 2026 15:36:24 +0100
Subject: [PATCH] thermal: spacemit: add K3 temperature sensor driver

The SpacemiT K3 has one ADC shared by up to 8 temperature sensors:
select a sensor in CFG2, then read TEMP_DATA. Register a thermal zone
for every sensor that has one in the device tree. Based on the
SpacemiT vendor driver (k3-br-v1.0.y); the per-chip efuse vref trim is
not read yet, the vendor default is used.

Upstream-Status: Pending
Signed-off-by: Thomas Roos <thomas@exein.io>
---
 drivers/thermal/spacemit/Kconfig      |   9 ++
 drivers/thermal/spacemit/Makefile     |   1 +
 drivers/thermal/spacemit/k3_tsensor.c | 145 ++++++++++++++++++++++++++
 3 files changed, 155 insertions(+)
 create mode 100644 drivers/thermal/spacemit/k3_tsensor.c

diff --git a/drivers/thermal/spacemit/Kconfig b/drivers/thermal/spacemit/Kconfig
index de7b5ece5af2..8ec5fe005efe 100644
--- a/drivers/thermal/spacemit/Kconfig
+++ b/drivers/thermal/spacemit/Kconfig
@@ -16,4 +16,13 @@ config SPACEMIT_K1_TSENSOR
 	  Say Y here if you want to enable thermal monitoring on SpacemiT K1.
 	  If compiled as a module, it will be called k1_tsensor.
 
+config SPACEMIT_K3_TSENSOR
+	tristate "SpacemiT K3 thermal sensor driver"
+	depends on THERMAL_OF
+	help
+	  This driver provides support for the thermal sensors integrated
+	  in the SpacemiT K3 SoC.
+
+	  If compiled as a module, it will be called k3_tsensor.
+
 endmenu
diff --git a/drivers/thermal/spacemit/Makefile b/drivers/thermal/spacemit/Makefile
index 82b30741e4ec..8ea3b3a6a96a 100644
--- a/drivers/thermal/spacemit/Makefile
+++ b/drivers/thermal/spacemit/Makefile
@@ -1,3 +1,4 @@
 # SPDX-License-Identifier: GPL-2.0-only
 
 obj-$(CONFIG_SPACEMIT_K1_TSENSOR)	+= k1_tsensor.o
+obj-$(CONFIG_SPACEMIT_K3_TSENSOR)	+= k3_tsensor.o
diff --git a/drivers/thermal/spacemit/k3_tsensor.c b/drivers/thermal/spacemit/k3_tsensor.c
new file mode 100644
index 000000000000..10f83757df5d
--- /dev/null
+++ b/drivers/thermal/spacemit/k3_tsensor.c
@@ -0,0 +1,145 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * SpacemiT K3 temperature sensor, based on the SpacemiT vendor driver
+ * (k3-br-v1.0.y, drivers/thermal/k3-thermal.c).
+ *
+ * One ADC is shared by up to 8 sensors: select a sensor in CFG2, then
+ * read TEMP_DATA.
+ */
+#include <linux/bitfield.h>
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/platform_device.h>
+#include <linux/reset.h>
+#include <linux/thermal.h>
+
+#include "../thermal_hwmon.h"
+
+#define K3_TSEN_CFG			0x00
+#define K3_TSEN_CFG_EN			BIT(0)
+#define K3_TSEN_CFG_CK_DIV		GENMASK(3, 2)	/* 0: 26 MHz / 4 */
+#define K3_TSEN_CFG_VREF		GENMASK(14, 7)
+#define K3_TSEN_CFG2			0x04
+#define K3_TSEN_INT_ENB			0x08
+#define K3_TSEN_INT_CLR			0x10
+#define K3_TSEN_TEMP_DATA		0x18
+#define K3_TSEN_TEMP_MASK		GENMASK(11, 0)
+
+#define K3_TSEN_NUM			8
+/* ponytail: vendor default vref; the per-chip efuse trim is not read yet */
+#define K3_TSEN_VREF_DEFAULT		0xd8
+#define K3_TSEN_TEMP_OFFSET		274	/* vendor DT temperature_offset */
+#define K3_TSEN_RAW_DIV			8
+
+struct k3_tsensor {
+	void __iomem *base;
+	struct mutex lock;	/* one ADC, sensor select + read */
+};
+
+struct k3_tsensor_channel {
+	struct k3_tsensor *ts;
+	unsigned int id;
+};
+
+static int k3_tsensor_get_temp(struct thermal_zone_device *tz, int *temp)
+{
+	struct k3_tsensor_channel *ch = thermal_zone_device_priv(tz);
+	struct k3_tsensor *ts = ch->ts;
+	u32 raw;
+
+	mutex_lock(&ts->lock);
+	writel(ch->id, ts->base + K3_TSEN_CFG2);
+	usleep_range(1000, 1500);
+	raw = readl(ts->base + K3_TSEN_TEMP_DATA) & K3_TSEN_TEMP_MASK;
+	mutex_unlock(&ts->lock);
+
+	*temp = ((int)(raw / K3_TSEN_RAW_DIV) - K3_TSEN_TEMP_OFFSET) * 1000;
+	return 0;
+}
+
+static const struct thermal_zone_device_ops k3_tsensor_ops = {
+	.get_temp = k3_tsensor_get_temp,
+};
+
+static int k3_tsensor_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct reset_control *rst;
+	struct k3_tsensor *ts;
+	struct clk *clk;
+	unsigned int i;
+	u32 val;
+
+	ts = devm_kzalloc(dev, sizeof(*ts), GFP_KERNEL);
+	if (!ts)
+		return -ENOMEM;
+	mutex_init(&ts->lock);
+
+	ts->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(ts->base))
+		return PTR_ERR(ts->base);
+
+	rst = devm_reset_control_get_optional_exclusive_deasserted(dev, NULL);
+	if (IS_ERR(rst))
+		return dev_err_probe(dev, PTR_ERR(rst), "failed to get reset\n");
+
+	clk = devm_clk_get_enabled(dev, "func");
+	if (IS_ERR(clk))
+		return dev_err_probe(dev, PTR_ERR(clk), "failed to get func clock\n");
+	clk = devm_clk_get_enabled(dev, "bus");
+	if (IS_ERR(clk))
+		return dev_err_probe(dev, PTR_ERR(clk), "failed to get bus clock\n");
+
+	/* no interrupts, polled through the thermal zones */
+	writel(~0U, ts->base + K3_TSEN_INT_CLR);
+	writel(~0U, ts->base + K3_TSEN_INT_ENB);
+
+	val = readl(ts->base + K3_TSEN_CFG);
+	val &= ~(K3_TSEN_CFG_CK_DIV | K3_TSEN_CFG_VREF);
+	val |= FIELD_PREP(K3_TSEN_CFG_VREF, K3_TSEN_VREF_DEFAULT) | K3_TSEN_CFG_EN;
+	writel(val, ts->base + K3_TSEN_CFG);
+
+	/* register a zone for every sensor the DT has a thermal zone for */
+	for (i = 0; i < K3_TSEN_NUM; i++) {
+		struct k3_tsensor_channel *ch;
+		struct thermal_zone_device *tz;
+
+		ch = devm_kzalloc(dev, sizeof(*ch), GFP_KERNEL);
+		if (!ch)
+			return -ENOMEM;
+		ch->ts = ts;
+		ch->id = i;
+
+		tz = devm_thermal_of_zone_register(dev, i, ch, &k3_tsensor_ops);
+		if (IS_ERR(tz)) {
+			if (PTR_ERR(tz) == -ENODEV)
+				continue;
+			return dev_err_probe(dev, PTR_ERR(tz),
+					     "failed to register sensor %u\n", i);
+		}
+		devm_thermal_add_hwmon_sysfs(dev, tz);
+	}
+
+	return 0;
+}
+
+static const struct of_device_id k3_tsensor_of_match[] = {
+	{ .compatible = "spacemit,k3-tsensor" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, k3_tsensor_of_match);
+
+static struct platform_driver k3_tsensor_driver = {
+	.driver = {
+		.name = "k3_tsensor",
+		.of_match_table = k3_tsensor_of_match,
+	},
+	.probe = k3_tsensor_probe,
+};
+module_platform_driver(k3_tsensor_driver);
+
+MODULE_DESCRIPTION("SpacemiT K3 temperature sensor driver");
+MODULE_LICENSE("GPL");
-- 
2.56.0

