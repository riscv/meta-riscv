@@ -326,7 +326,6 @@ static struct cpufreq_driver th1520_cpufreq_driver = {
 	.init = th1520_cpufreq_init,
 	.register_em = cpufreq_register_em_with_opp,
 	.name = "th1520-cpufreq",
-	.attr = cpufreq_generic_attr,
 	.suspend = th1520_cpufreq_suspend,
 	.resume = th1520_cpufreq_resume,
 };
@@ -494,7 +493,7 @@ static int th1520_cpufreq_probe(struct platform_device *pdev)
 		dev_warn(cpu_dev, "Not find valid th1520,dvddm-operating-points property\n");
 
 	if (of_property_read_u32(np, "clock-latency", &transition_latency))
-		transition_latency = CPUFREQ_ETERNAL;
+		transition_latency = CPUFREQ_DEFAULT_TRANSITION_LATENCY_NS;
 
 	max_freq = freq_table[--num].frequency;
 	min_freq = freq_table[0].frequency;
diff --git a/drivers/cpufreq/zhihe-cpufreq.c b/drivers/cpufreq/zhihe-cpufreq.c
index 14edf09e0ace5..5ea26d03b7c55 100644
--- a/drivers/cpufreq/zhihe-cpufreq.c
+++ b/drivers/cpufreq/zhihe-cpufreq.c
@@ -62,11 +62,6 @@ struct zh_cpufreq_cluster_data {
 
 static LIST_HEAD(info_list);
 
-static struct freq_attr *zh_cpufreq_attr[] = {
-	&cpufreq_freq_attr_scaling_available_freqs,
-	NULL,   /* Extra space for boost-attr if required */
-	NULL,
-};
 
 static struct zh_cpufreq_cluster_data *zh_cpufreq_cluster_data_lookup(int cpu)
 {
@@ -97,7 +92,6 @@ static int zh_cpufreq_init(struct cpufreq_policy *policy)
 	struct zh_cpufreq_cluster_data *cluster;
 	struct device *cpu_dev;
 	unsigned int transition_latency;
-	int ret;
 
 	cluster = zh_cpufreq_cluster_data_lookup(policy->cpu);
 	if (!cluster) {
@@ -108,7 +102,7 @@ static int zh_cpufreq_init(struct cpufreq_policy *policy)
 
 	transition_latency = dev_pm_opp_get_max_transition_latency(cpu_dev);
 	if (!transition_latency)
-		transition_latency = CPUFREQ_ETERNAL;
+		transition_latency = CPUFREQ_DEFAULT_TRANSITION_LATENCY_NS;
 
 	cpumask_copy(policy->cpus, cluster->cpus);
 	policy->driver_data = cluster;
@@ -118,22 +112,18 @@ static int zh_cpufreq_init(struct cpufreq_policy *policy)
 	policy->cpuinfo.transition_latency = transition_latency;
 	policy->dvfs_possible_from_any_cpu = true;
 
-	/* Support turbo/boost mode */
-	if (policy_has_boost_freq(policy)) {
-		/* This gets disabled by core on driver unregister */
-		ret = cpufreq_enable_boost_support();
-		if (ret)
-			return ret;
-		zh_cpufreq_attr[1] = &cpufreq_freq_attr_scaling_boost_freqs;
-	}
+	/*
+	 * Boost/turbo frequencies are detected from the freq table and
+	 * exposed by the cpufreq core via the .set_boost callback below;
+	 * drivers no longer wire up the boost attribute by hand.
+	 */
 
 	return 0;
 }
 
-static int zh_cpufreq_exit(struct cpufreq_policy *policy)
+static void zh_cpufreq_exit(struct cpufreq_policy *policy)
 {
 	clk_put(policy->clk);
-	return 0;
 }
 
 static int zh_set_target(struct cpufreq_policy *policy, unsigned int index)
@@ -177,7 +167,7 @@ static struct cpufreq_driver zh_cpufreq_driver = {
 	.offline = zh_cpufreq_offline,
 	.register_em = cpufreq_register_em_with_opp,
 	.name = "zh-cpufreq",
-	.attr = zh_cpufreq_attr,
+	.set_boost = cpufreq_boost_set_sw,
 	.suspend = cpufreq_generic_suspend,
 };
 
