 static int th1520_rpmsg_find_vqs(struct virtio_device *vdev, unsigned int nvqs,
 				 struct virtqueue *vqs[],
-				 vq_callback_t *callbacks[],
-				 const char *const names[], const bool *ctx,
+				 struct virtqueue_info vqs_info[],
 				 struct irq_affinity *desc)
 {
 	struct th1520_virdev *virdev = to_th1520_virdev(vdev);
@@ -313,8 +312,10 @@ static int th1520_rpmsg_find_vqs(struct virtio_device *vdev, unsigned int nvqs,
 		return -EINVAL;
 
 	for (i = 0; i < nvqs; ++i) {
-		vqs[i] = rp_find_vq(vdev, i, callbacks[i], names[i],
-				    ctx ? ctx[i] : false);
+		struct virtqueue_info *vqi = &vqs_info[i];
+
+		vqs[i] = rp_find_vq(vdev, i, vqi->callback, vqi->name,
+				    vqi->ctx);
 		if (IS_ERR(vqs[i])) {
 			err = PTR_ERR(vqs[i]);
 			goto error;
