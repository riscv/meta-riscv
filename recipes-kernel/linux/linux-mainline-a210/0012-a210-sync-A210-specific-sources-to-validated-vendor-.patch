@@ -1297,18 +1333,21 @@ &c908_0 {
 /*
  * OSL: drop pmic-supply on power_gpu / power_npu_wrapper / power_vp_wrapper.
  *
- * The a210-pd driver iterates ALL child power-domain nodes during probe and
- * returns -EPROBE_DEFER as soon as a `pmic-supply` regulator phandle can't be
- * resolved. dvdd_gpu_reg / dvdd_npu_vip_reg / dvdd_vp_reg are PMIC outputs --
- * we don't have the PMIC driver path wired up yet, so the regulator framework
- * never produces them and the a210-pd probe defers forever. That cascades:
- * the console UART (uart4 at 0x08401000) depends on power_peri2 from this
- * same provider, so /dev/console can't open, /init's exec redirect fails,
- * and the kernel panics with exitcode=2.
+ * a210-pd's probe iterates ALL child power-domain nodes and returns
+ * -EPROBE_DEFER as soon as one `pmic-supply` regulator phandle can't be
+ * resolved. dvdd_gpu_reg / dvdd_npu_vip_reg / dvdd_vp_reg are PMIC
+ * outputs whose driver chain doesn't fully come up here -- vendor's AON
+ * E902 RPC (308f8000.aon_subsys) times out at boot because we don't have
+ * the firmware vendor expects on that always-on co-processor, and the
+ * PMIC/regulator init depends on that path. Without removing these
+ * pmic-supply references, the power-domain provider stays deferred
+ * forever and EVERYTHING downstream defers too: i2c controllers,
+ * dw-apb-uart (so ttyS4 never registers), sdhci (so eMMC never appears
+ * as /dev/mmcblk0 for writer.sh), gmac, ...
  *
- * GPU / NPU / VP power management isn't needed for boot-up or the installer
- * flow; for now we drop the references and let those domains stay in whatever
- * state U-Boot left them. Re-add once we have the PMIC driver and regulators.
+ * GPU / NPU / video-processing power management isn't needed for the
+ * installer flow; those subsystems stay in whatever state U-Boot left
+ * them. Re-add once the AON RPC / PMIC chain is figured out.
  */
 &power_gpu {
 	/delete-property/ pmic-supply;
diff --git a/arch/riscv/boot/dts/zhihe/a210-platform-dev.dtsi b/arch/riscv/boot/dts/zhihe/a210-platform-dev.dtsi
