+++ b/arch/riscv/boot/dts/zhihe/a210-platform-dev.dtsi
@@ -102,8 +102,23 @@ &rp3x1 {
 	status = "disabled";
 };
 
+/*
+ * OSL: disable PCIe (dm3x4) + the shared combo PHY (e16phy).
+ *
+ * dm3x4 was the last enabled consumer of e16phy (rp3x1/usb3/sata already
+ * disabled). With udev present, systemd's coldplug drives the full probe
+ * and the e16phy driver dumps its entire register bank (000-0f0) on the
+ * console during boot -- a deferred-probe/error spew that floods the
+ * 115200 serial line and stalls boot before it ever reaches
+ * multi-user.target (no login prompt). We don't need PCIe for the
+ * installer or basic operation; disable both so the PHY never probes.
+ */
 &dm3x4 {
-	status = "okay";
+	status = "disabled";
+};
+
+&e16phy {
+	status = "disabled";
 };
 
 &auxdisp {
@@ -237,15 +252,19 @@ &gpio4 {
 };
 
 /*
- * OSL: disable non-installer subsystems.
+ * OSL: disable non-installer subsystems on this build.
  *
- * The deferred-probe pass wedges silently in one of the larger driver
- * probes after a210-pd / a210-clk come up. We don't need USB / display /
- * GPU / video codecs / SATA / type-c for the installer (UART + eMMC +
- * ethernet only). Disabling them here skips those probes entirely and
- * unblocks boot to /init. Re-enable individually once we actually need
- * them (and once we have the PMIC / regulator wiring for the bits that
- * need power management).
+ * On vendor's tree, dwc3 (USB3), typec, display (dpu/dsi/hdmi/dp), GPU,
+ * video codecs (venc/vdec), SATA, and the per-subsystem BMUs all probe
+ * fine when their power-on chains complete normally -- but vendor's
+ * power-on chains for those domains depend on the AON E902 RPC and the
+ * PMIC drivers we don't have. With those upstream pieces broken, the
+ * probes hang. Disable them; they're not required for the installer
+ * (UART console + eMMC + ethernet only).
+ *
+ * Re-enable individually once we either: (a) wire up the AON RPC
+ * firmware, (b) import PMIC driver bits, or (c) confirm the specific
+ * subsystem doesn't actually need either.
  */
 &usb3 {
 	status = "disabled";
@@ -255,13 +274,6 @@ &usb31_c10phy {
 	status = "disabled";
 };
 
-/*
- * &fusb302 (typec-portc@22) is declared inside &i2c7 { ... } in a210-dev.dts.
- * DTC's label resolution can't reach it from this overlay's include position
- * ("Label or path fusb302 not found"). With &usb3 (dwc3) disabled the typec
- * controller has no role to coordinate, so leave fusb302 alone.
- */
-
 &dpu {
 	status = "disabled";
 };
@@ -297,3 +309,27 @@ &vdec {
 &sata {
 	status = "disabled";
 };
+
+/*
+ * BMUs (Bus Monitor Units): performance counters, not needed for boot.
+ * In phase A their probes wedged in pm_runtime_get on power domains
+ * whose power-on callbacks hung in MMIO ready-loops.
+ *  bmu0 = ddr-bmu  (kept; on power_top, always-on)
+ *  bmu1 = gpu-bmu
+ *  bmu2 = npu-bmu
+ *  bmu3 = pcie-bmu
+ *  bmu4 = usb-bmu
+ *  bmu5 = vo-bmu
+ *  bmu6 = vi-bmu
+ *  bmu7 = vp-bmu
+ *  bmu8 = peri-bmu (kept; on power_top, always-on)
+ *  bmu9 = d2d-bmu
+ */
+&bmu1 { status = "disabled"; };
+&bmu2 { status = "disabled"; };
+&bmu3 { status = "disabled"; };
+&bmu4 { status = "disabled"; };
+&bmu5 { status = "disabled"; };
+&bmu6 { status = "disabled"; };
+&bmu7 { status = "disabled"; };
+&bmu9 { status = "disabled"; };
