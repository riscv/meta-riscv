From a4d38698f2207db310e0bce1b5a8f0f43ca58a4d Mon Sep 17 00:00:00 2001
From: Lance Albertson <lance@osuosl.org>
Date: Fri, 12 Jun 2026 09:39:44 -0700
Subject: [PATCH 10/31] watchdog: zhihe: a210: reset the SoC from a reboot
 notifier

The only working SoC reset path on this board is an RPC to the AON E902
co-processor; there is no SBI SRST and no syscon-reboot node. zhihe_wdt
already implements that RPC and registers it as the watchdog core's
.restart handler, but .restart runs from machine_restart(), i.e. after
kernel_restart_prepare() has run device_shutdown(), migrate_to_reboot_cpu()
and syscore_shutdown(). Those tear down the mailbox IRQ path the RPC
depends on, so on a normal reboot(2) the restart RPC can no longer reach
the AON and the board wedges in machine_restart()'s spin, requiring a
physical reset.

A sysrq 'b' reboot resets the board correctly because emergency_restart()
jumps straight to machine_restart() and skips that teardown -- proving the
RPC itself works and the problem is purely ordering.

Send the restart RPC from a reboot notifier instead. The reboot notifier
chain runs at the very top of kernel_restart_prepare(), before any
teardown, while the mailbox is still alive, so the AON receives the
request and power-cycles the SoC via RST_OUT/PMIC. The existing .restart
handler is left in place as a (now unreached) fallback.

Co-developed-by: Claude Opus 4.8 <noreply@anthropic.com>
Signed-off-by: Lance Albertson <lance@osuosl.org>
Upstream-Status: Pending
---
 drivers/watchdog/zhihe_wdt.c | 41 ++++++++++++++++++++++++++++++++++++
 1 file changed, 41 insertions(+)

diff --git a/drivers/watchdog/zhihe_wdt.c b/drivers/watchdog/zhihe_wdt.c
index 9cea04331f75a..7e5d42ab84ec4 100755
--- a/drivers/watchdog/zhihe_wdt.c
+++ b/drivers/watchdog/zhihe_wdt.c
@@ -18,6 +18,7 @@
 #include <linux/watchdog.h>
 #include <linux/firmware/zhihe/ipc.h>
 #include <linux/delay.h>
+#include <linux/reboot.h>
 
 #define DRV_NAME	"zhihe-wdt"
 
@@ -54,6 +55,7 @@ struct zhihe_wdt_device {
 	struct zhihe_aon_ipc *ipc_handle;
 	struct aon_msg_wdg_ctrl msg;
 	unsigned int    is_aon_wdt_ena;
+	struct notifier_block reboot_nb;
 };
 
 struct zhihe_wdt_device *zhihe_power_off_wdt;
@@ -289,6 +291,40 @@ static const struct attribute_group dev_attr_aon_sys_wdt_group = {
 	.attrs = aon_sys_wdt_sysfs_entries,
 };
 
+/*
+ * The only working SoC reset path is an RPC to the AON E902. The watchdog
+ * core's .restart handler (zhihe_wdt_restart) runs from machine_restart(),
+ * i.e. *after* device_shutdown()/migrate_to_reboot_cpu()/syscore_shutdown()
+ * have torn down the mailbox IRQ path the RPC needs -- so on a normal
+ * reboot(2) the RPC can no longer reach the AON and the board wedges in
+ * machine_restart()'s spin. (sysrq 'b', which jumps straight to
+ * machine_restart() and skips that teardown, resets fine -- proving the RPC
+ * itself works.) Send the restart RPC from a reboot notifier instead: the
+ * reboot notifier chain runs at the very top of kernel_restart_prepare(),
+ * before any teardown, while the mailbox is still alive.
+ */
+static int zhihe_wdt_reboot_notify(struct notifier_block *nb,
+				   unsigned long action, void *data)
+{
+	struct zhihe_wdt_device *wdt_dev =
+		container_of(nb, struct zhihe_wdt_device, reboot_nb);
+
+	if (action != SYS_RESTART)
+		return NOTIFY_DONE;
+
+	zhihe_wdt_msg_hdr_fill(&wdt_dev->msg.hdr, AON_WDG_FUNC_RESTART);
+	zhihe_aon_call_rpc(wdt_dev->ipc_handle, &wdt_dev->msg, NULL, false);
+
+	/*
+	 * On success the AON resets the SoC within the reset-protection window
+	 * and we never return; the delay just gives it time to assert before
+	 * the (now-doomed) normal restart path resumes.
+	 */
+	mdelay(ZHIHE_RESET_PROTECTION_MS);
+
+	return NOTIFY_DONE;
+}
+
 static int zhihe_wdt_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
@@ -339,6 +375,11 @@ static int zhihe_wdt_probe(struct platform_device *pdev)
 	if (ret)
 		return ret;
 
+	wdt_dev->reboot_nb.notifier_call = zhihe_wdt_reboot_notify;
+	ret = devm_register_reboot_notifier(dev, &wdt_dev->reboot_nb);
+	if (ret)
+		return ret;
+
 	pm_power_off = zhihe_pm_power_off;
 	zhihe_power_off_wdt = wdt_dev;
 	ret = sysfs_create_group(&pdev->dev.kobj, &dev_attr_aon_sys_wdt_group);
-- 
