+ * GPU / NPU / VP power management isn't needed for boot-up or the installer
+ * flow; for now we drop the references and let those domains stay in whatever
+ * state U-Boot left them. Re-add once we have the PMIC driver and regulators.
+ */
+&power_gpu {
+	/delete-property/ pmic-supply;
+};
+
+&power_npu_wrapper {
+	/delete-property/ pmic-supply;
+};
+
+&power_vp_wrapper {
