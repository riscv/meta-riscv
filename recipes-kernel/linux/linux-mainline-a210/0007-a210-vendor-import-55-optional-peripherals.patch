+
+	//spin_lock_irqsave(&rpdev->mu_lock, flags);
+	blocking_notifier_call_chain(&(rpdev->notifier), 4, (void *)message);
+	//spin_unlock_irqrestore(&rpdev->mu_lock, flags);
+}
