+	dw_writel(dws, DW_SPI_SPI_CTRLR0, ctx->spi_ctrlr0);
+	dw_writel(dws, DW_SPI_TXD_DRV_EDGE, ctx->txd_drv_edge);
+	dw_writel(dws, DW_SPI_SER, ctx->ser);
+	dw_writel(dws, DW_SPI_BAUDR, ctx->baudr);
+	dw_writel(dws, DW_SPI_MWCR, ctx->mwcr);
