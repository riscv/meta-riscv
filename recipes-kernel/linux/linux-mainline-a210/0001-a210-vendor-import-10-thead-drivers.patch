diff --git a/drivers/iopmp/Makefile b/drivers/iopmp/Makefile
new file mode 100644
index 0000000000000..c2844ec6cf6b8
--- /dev/null
+++ b/drivers/iopmp/Makefile
@@ -0,0 +1,2 @@
