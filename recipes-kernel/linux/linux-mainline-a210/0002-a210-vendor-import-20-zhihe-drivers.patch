+static int dw_dphy_power_off(struct phy *phy)
+{
+	struct dw_dphy *dphy = phy_get_drvdata(phy);
+
+	dw_dphy_config_rstz(dphy, 0);
+
+	dw_dphy_config_enableclk(dphy, 0);
+
+	dw_dphy_config_shutdownz(dphy, 0);
+
+	pm_runtime_put(dphy->dev);
+
+	return 0;
+}
