+			val &= ~(BMU3_CFG_FULL_AXI_INT_EN |
+				 BMU3_CFG_AXI_RESP_ERR_INT_EN |
+				 BMU3_CFG_BUFF_FULL_INT_EN);
+		}
+		writel(val, pmu->pmu_base[i].base + BMU3_CFG);
+	}
+}
