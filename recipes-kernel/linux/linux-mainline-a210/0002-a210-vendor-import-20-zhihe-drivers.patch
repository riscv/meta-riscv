+static int dw_dphy_power_on(struct phy *phy)
+{
+	struct dw_dphy *dphy = phy_get_drvdata(phy);
+
+	pm_runtime_get_sync(dphy->dev);
+
+	dw_dphy_config_enableclk(dphy, 1);
+
+	dw_dphy_config_shutdownz(dphy, 1);
+
+	dw_dphy_config_rstz(dphy, 1);
+
+	return 0;
+}
