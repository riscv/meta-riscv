+			shift, 0, &zhihe_clk_lock);
+}
+
+struct clk *zhihe_clk_register_gate_shared(struct device *dev, const char *name, const char *parent,
+						 unsigned long flags, void __iomem *reg,
+						 u8 shift, spinlock_t *lock,
