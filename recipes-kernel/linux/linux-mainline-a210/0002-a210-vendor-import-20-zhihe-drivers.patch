+	} else {
+		if (ch >= private->reg_group_num) {
+			return;
+		}
+		bmu3_ext_int_enable(pmu, ch, 0);
+		ddr_pmu_clear_irq(pmu, ch);
+
+		mb();
+		val1 = readl_relaxed(pmu->pmu_base[ch].base + BMU3_CFG);
+		val1 |= BMU3_CFG_RESET;
+		writel(val1, pmu->pmu_base[ch].base + BMU3_CFG); //reset
