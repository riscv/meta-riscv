+static int dw_dphy_init(struct phy *phy)
+{
+	struct dw_dphy *dphy = phy_get_drvdata(phy);
+
+	pm_runtime_get_sync(dphy->dev);
+
+	/* reset testclr */
+	dw_dphy_config_testclr(dphy, 1);
+	dw_dphy_config_testclr(dphy, 0);
+
+	pm_runtime_put(dphy->dev);
+
+	return 0;
+}
