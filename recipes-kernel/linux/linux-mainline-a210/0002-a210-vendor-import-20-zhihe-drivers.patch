+	u32 shutdownz = FIELD_PREP(PHY_RSTZ_PHY_SHUTDOWNZ, !!val);
+
+	ret = regmap_update_bits(dphy->regmap, DW_PHY_RSTZ,
+				 PHY_RSTZ_PHY_SHUTDOWNZ, shutdownz);
+	if (ret)
+		dev_err(dphy->dev, "config shutdownz failed: %d\n", ret);
+
+	return ret;
+}
