diff --git a/sound/soc/zhihe/zhihe-pdm.c b/sound/soc/zhihe/zhihe-pdm.c
new file mode 100644
index 0000000000000..fe73394b54c87
--- /dev/null
+++ b/sound/soc/zhihe/zhihe-pdm.c
@@ -0,0 +1,595 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Copyright (C) 2021 Alibaba Group Holding Limited.
+ */
+
+#include <linux/dma/dw-axi-dma.h>
+#include <sound/sh_fsi.h>
+#include <linux/mfd/syscon.h>
+#include <linux/module.h>
+#include <linux/of_device.h>
+#include <linux/pm_runtime.h>
+#include <linux/slab.h>
+#include <sound/initval.h>
+#include <sound/pcm_params.h>
+#include <linux/reset.h>
+
+#include "zhihe-pdm.h"
+
+#define AUDIO_PDM0		"audio_pdm0"
+#define AUDIO_PDM1		"audio_pdm1"
+#define AUDIO_PDM2		"audio_pdm2"
+#define AUDIO_PDM3		"audio_pdm3"
+#define AUDIO_PDM4		"audio_pdm4"
+#define AUDIO_PDM5		"audio_pdm5"
+#define AUDIO_PDM6		"audio_pdm6"
+#define AUDIO_PDM7		"audio_pdm7"
+
+#define ZHIHE_PDM_DMABUF_SIZE	(64 * 1024)
+#define ZHIHE_PDM_DMA_MAXBURST	8
+#define ZHIHE_PDM_GAIN_MAXCNT	8
+#define ZHIHE_PDM_GAIN_DEFAULT	6
+#define ZHIHE_PDM_RATES		SNDRV_PCM_RATE_8000_384000
+#define ZHIHE_PDM_FMTS		SNDRV_PCM_FMTBIT_S16_LE
+#define ZHIHE_PDM_INTR_MASK	0x44444444
+
+static int pdm_probe_flag = 0;
+struct zhihe_pdm_priv *host_priv;
+
+static const u32 pdm_gain_dB[ZHIHE_PDM_GAIN_MAXCNT] = { 0, 6, 12, 18, 24, 30, 36, 42 };
+
+static u32 zhihe_pdm_gain_parse(u32 arg)
+{
+	u32 pos;
+
+	for (pos = 0; pos < ZHIHE_PDM_GAIN_MAXCNT; pos++) {
+		if (arg <= pdm_gain_dB[pos])
+			return pos;
+	}
+
+	return ZHIHE_PDM_GAIN_MAXCNT - 1;
+}
+
+static void zhihe_pdm_reg_init(struct zhihe_pdm_priv *pdm_priv)
+{
+	u32 val = zhihe_pdm_gain_parse(pdm_priv->gain_dB);
+
+	/* Enable pdm all channels */
+	regmap_update_bits(pdm_priv->regmap, CP_VAD_CTRL, VADCTRL_CH_EN_MSK,
+			   VADCTRL_ALL_CH_EN);
+
+	/* Set pdm gain */
+	regmap_update_bits(pdm_priv->regmap, CP_DAI_CTRL,
+			   DAI_LP_GAIN_MSK | DAI_ST_GAIN_MSK,
+			   val << DAI_LP_GAIN_POS | val << DAI_ST_GAIN_POS);
+
+	/* Based on DV case, mask fifo empty and overflow intr */
+	regmap_write(pdm_priv->regmap, CP_FIFO_INTR_MASK, ZHIHE_PDM_INTR_MASK);
+
+	/* Set cic offset */
+	if (pdm_priv->cic_offset_en) {
+		regmap_write(pdm_priv->regmap, CP_CIC_L_ST_OFFSET, pdm_priv->cic_offset[0]);
+		regmap_write(pdm_priv->regmap, CP_CIC_L_LP_OFFSET, pdm_priv->cic_offset[1]);
+		regmap_write(pdm_priv->regmap, CP_CIC_R_ST_OFFSET, pdm_priv->cic_offset[2]);
+		regmap_write(pdm_priv->regmap, CP_CIC_R_LP_OFFSET, pdm_priv->cic_offset[3]);
+	}
+}
+
+static inline void zhihe_pdm_snd_rxctrl(struct zhihe_pdm_priv *chip, bool on)
+{
+	if (on) {
+		regmap_update_bits(chip->regmap,
+				   CP_VAD_CTRL,
+				   VADCTRL_PDM_EN_MSK, 
+				   VADCTRL_VAD_EN_SEL | 
+				   VADCTRL_DATA_TRANS_EN_SEL);
+		regmap_update_bits(chip->regmap, 
+				   CP_DAI_EN, 
+				   DAI_EN_MSK, 
+				   DAI_EN_SEL);
+	} else {
+		regmap_update_bits(chip->regmap, 
+				   CP_VAD_CTRL, 
+				   VADCTRL_PDM_EN_MSK, 
+				   ~VADCTRL_VAD_EN_SEL & 
+				   ~VADCTRL_DATA_TRANS_EN_SEL);
+		regmap_update_bits(chip->regmap, 
+				   CP_DAI_EN, 
+				   DAI_EN_MSK, 
+				   ~DAI_EN_SEL);
+	}
+}
+
+static int zhihe_pdm_dai_startup(struct snd_pcm_substream *substream,
+				 struct snd_soc_dai *dai)
+{
+	struct zhihe_pdm_priv *priv = snd_soc_dai_get_drvdata(dai);
+	unsigned int dma_reuse;
+
+	if (!priv->sys_regmap)
+		return -EINVAL;
+
+	regmap_read(priv->sys_regmap, PERI1_DMA_REUSE_CSR, &dma_reuse);
+	if (dma_reuse != PDM_DMA_REUSE_SEL)
+		regmap_write(priv->sys_regmap, PERI1_DMA_REUSE_CSR, PDM_DMA_REUSE_SEL);
+
+	return 0;
+}
+
+static void zhihe_pdm_dai_shutdown(struct snd_pcm_substream *substream,
+				   struct snd_soc_dai *dai)
+{
+	struct zhihe_pdm_priv *pdm_private = snd_soc_dai_get_drvdata(dai);
+
+	if (substream->stream == SNDRV_PCM_STREAM_CAPTURE)
+		zhihe_pdm_snd_rxctrl(pdm_private, 0);
+}
+
+/**
+ * zhihe_pdm_dai_trigger: start and stop the DMA transfer.
+ *
+ * This function is called by ALSA to start, stop, pause, and resume the DMA
+ * transfer of data.
+ */
+static int zhihe_pdm_dai_trigger(struct snd_pcm_substream *substream,
+				 int cmd, struct snd_soc_dai *dai)
+{
+	int ret = 0;
+	struct zhihe_pdm_priv *priv = snd_soc_dai_get_drvdata(dai);
+
+	switch (cmd) {
+	case SNDRV_PCM_TRIGGER_START:
+	case SNDRV_PCM_TRIGGER_RESUME:
+	case SNDRV_PCM_TRIGGER_PAUSE_RELEASE:
+		zhihe_pdm_snd_rxctrl(priv, 1);
+		break;
+	case SNDRV_PCM_TRIGGER_STOP:
+		dmaengine_terminate_async(snd_dmaengine_pcm_get_chan(substream));
+		zhihe_pdm_snd_rxctrl(priv, 0);
+		break;
+	case SNDRV_PCM_TRIGGER_SUSPEND:
+	case SNDRV_PCM_TRIGGER_PAUSE_PUSH:
+		dmaengine_pause(snd_dmaengine_pcm_get_chan(substream));
+		zhihe_pdm_snd_rxctrl(priv, 0);
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	return ret;
+}
+
+static int zhihe_pdm_dai_set_fmt(struct snd_soc_dai *dai, unsigned int fmt)
+{
+	struct zhihe_pdm_priv *priv = snd_soc_dai_get_drvdata(dai);
+	unsigned int vad_status;
+
+	regmap_read(priv->sys_regmap, PERI1_PDM_TDM_CSR, &vad_status);
+	if ((vad_status & PDM_VAD_EN_MSK) == 0)
+		regmap_update_bits(priv->sys_regmap, PERI1_PDM_TDM_CSR,
+				   PDM_VAD_EN_MSK, PDM_VAD_EN_SEL);
+
+	return 0;
+}
+
+static int zhihe_pdm_dai_hw_params(struct snd_pcm_substream *substream, 
+				   struct snd_pcm_hw_params *params, 
+				   struct snd_soc_dai *dai)
+{
+	struct zhihe_pdm_priv *pdm_private = snd_soc_dai_get_drvdata(dai);
+
+	/* vad enable */
+	regmap_update_bits(pdm_private->regmap, 
+			   CP_VAD_CTRL, 
+			   VADCTRL_PDM_EN_MSK, 
+			   VADCTRL_VAD_EN_SEL | VADCTRL_DATA_TRANS_EN_SEL);
+	regmap_update_bits(pdm_private->regmap, 
+			   CP_DAI_EN, 
+			   DAI_EN_MSK, 
+			   DAI_EN_SEL);
+
+	return 0;
+}
+
+static int zhihe_pdm_dai_probe(struct snd_soc_dai *dai)
+{
+	struct zhihe_pdm_priv *pdm = snd_soc_dai_get_drvdata(dai);
+
+	if(pdm)
+		snd_soc_dai_init_dma_data(dai, NULL, &pdm->dma_params_rx);
+
+	return 0;
+}
+
+static const struct snd_soc_dai_ops zhihe_pdm_dai_ops = {
+	.probe		= zhihe_pdm_dai_probe,
+	.startup	= zhihe_pdm_dai_startup,
+	.shutdown	= zhihe_pdm_dai_shutdown,
+	.trigger	= zhihe_pdm_dai_trigger,
+	.set_fmt	= zhihe_pdm_dai_set_fmt,
+	.hw_params	= zhihe_pdm_dai_hw_params,
+};
+
+static struct snd_soc_dai_driver zhihe_pdm_soc_dai[] = {
+	{
+		.name = "zhihe-pdm-dai-0",
+		.capture = {
+			.rates		= ZHIHE_PDM_RATES,
+			.formats	= ZHIHE_PDM_FMTS,
+			.channels_min	= 1,
+			.channels_max	= 8,
+		},
+		.ops = &zhihe_pdm_dai_ops,
+		.symmetric_rate = 1,
+	},
+	{
+		.name = "zhihe-pdm-dai-1",
+		.capture = {
+			.rates		= ZHIHE_PDM_RATES,
+			.formats	= ZHIHE_PDM_FMTS,
+			.channels_min	= 1,
+			.channels_max	= 1,
+		},
+		.ops = &zhihe_pdm_dai_ops,
+		.symmetric_rate = 1,
+	},
+	{
+		.name = "zhihe-pdm-dai-2",
+		.capture = {
+			.rates		= ZHIHE_PDM_RATES,
+			.formats	= ZHIHE_PDM_FMTS,
+			.channels_min	= 1,
+			.channels_max	= 1,
+		},
+		.ops = &zhihe_pdm_dai_ops,
+		.symmetric_rate = 1,
+	},
+	{
+		.name = "zhihe-pdm-dai-3",
+		.capture = {
+			.rates		= ZHIHE_PDM_RATES,
+			.formats	= ZHIHE_PDM_FMTS,
+			.channels_min	= 1,
+			.channels_max	= 1,
+		},
+		.ops = &zhihe_pdm_dai_ops,
+		.symmetric_rate = 1,
+	},
+	{
+		.name = "zhihe-pdm-dai-4",
+		.capture = {
+			.rates		= ZHIHE_PDM_RATES,
+			.formats	= ZHIHE_PDM_FMTS,
+			.channels_min	= 1,
+			.channels_max	= 1,
+		},
+		.ops = &zhihe_pdm_dai_ops,
+		.symmetric_rate = 1,
+	},
+	{
+		.name = "zhihe-pdm-dai-5",
+		.capture = {
+			.rates		= ZHIHE_PDM_RATES,
+			.formats	= ZHIHE_PDM_FMTS,
+			.channels_min	= 1,
+			.channels_max	= 1,
+		},
+		.ops = &zhihe_pdm_dai_ops,
+		.symmetric_rate = 1,
+	},
+	{
+		.name = "zhihe-pdm-dai-6",
+		.capture = {
+			.rates		= ZHIHE_PDM_RATES,
+			.formats	= ZHIHE_PDM_FMTS,
+			.channels_min	= 1,
+			.channels_max	= 1,
+		},
+		.ops = &zhihe_pdm_dai_ops,
+		.symmetric_rate = 1,
+	},
+	{
+		.name = "zhihe-pdm-dai-7",
+		.capture = {
+			.rates		= ZHIHE_PDM_RATES,
+			.formats	= ZHIHE_PDM_FMTS,
+			.channels_min	= 1,
+			.channels_max	= 1,
+		},
+		.ops = &zhihe_pdm_dai_ops,
+		.symmetric_rate = 1,
+	},	
+};
+
+
+static const struct snd_soc_component_driver zhihe_pdm_soc_component = {
+	.name	= "zhihe_pdm",
+};
+
+static const struct reg_default zhihe_pdm_reg_defaults[] = {
+	{ CP_VAD_CTRL,		0x02010010 },
+	{ CP_ZCR_TH_CTRL,	0x0000461e },
+	{ CP_STE_HTH_CTRL,	0x00004844 },
+	{ CP_STE_LTH_CTRL,	0x0000036b },
+	{ CP_VAD_INTR_MASK,	0x00000001 },
+	{ CP_DAI_CTRL,		0x04400000 },
+	{ CP_FIFO_INTR_MASK,	0x00000057 },
+	{ CP_CIC_L_ST_OFFSET,	0x003d0000 },
+	{ CP_CIC_L_LP_OFFSET,	0x0001e700 },
+	{ CP_CIC_R_ST_OFFSET,	0x003d0000 },
+	{ CP_CIC_R_LP_OFFSET,	0x0001e700 },
+};
+
+static const struct regmap_config zhihe_pdm_regmap_config = {
+	.reg_bits	= 32,
+	.reg_stride	= 4,
+	.val_bits	= 32,
+	.max_register	= CP_VAD_IP_ID,
+	.reg_defaults	= zhihe_pdm_reg_defaults,
+	.num_reg_defaults = ARRAY_SIZE(zhihe_pdm_reg_defaults),
+	.cache_type	= REGCACHE_NONE,
+};
+
+static int zhihe_pdm_runtime_suspend(struct device *dev)
+{
+	struct zhihe_pdm_priv *pdm_priv = dev_get_drvdata(dev);
+
+	if (!pdm_priv->mclk_keepon) {
+		regcache_cache_only(pdm_priv->regmap, true);
+		clk_disable_unprepare(pdm_priv->mclk);
+	}
+
+	clk_disable_unprepare(pdm_priv->pclk);
+
+	return 0;
+}
+
+static int zhihe_pdm_runtime_resume(struct device *dev)
+{
+	struct zhihe_pdm_priv *pdm_priv = dev_get_drvdata(dev);
+	int ret;
+
+	ret = clk_prepare_enable(pdm_priv->pclk);
+	if (ret) {
+		dev_err(pdm_priv->dev, "pclk enable failed %d\n", ret);
+		return ret;
+	}
+
+	if (!pdm_priv->mclk_keepon) {
+		ret = clk_prepare_enable(pdm_priv->mclk);
+		if (ret) {
+			dev_err(pdm_priv->dev, "mclk enable failed %d\n", ret);
+			return ret;
+		}
+
+		regcache_cache_only(pdm_priv->regmap, false);
+	}
+
+	return ret;
+}
+
+static const struct of_device_id zhihe_pdm_of_match[] = {
+	{ .compatible = "zhihe,pdm"},
+	{},
+};
+
+MODULE_DEVICE_TABLE(of, zhihe_pdm_of_match);
+
+static int zhihe_pdm_probe(struct platform_device *pdev)
+{
+	struct device_node *np = pdev->dev.of_node;
+	const char *sprop;
+	const uint32_t *iprop;
+	struct zhihe_pdm_priv *pdm_priv;
+	struct resource *res;
+	struct axi_dma_peripheral_config *dma_pcfg;
+	struct device *dev = &pdev->dev;
+	unsigned int irq;
+	int ret;
+
+	pdm_priv = devm_kzalloc(&pdev->dev, sizeof(*pdm_priv), GFP_KERNEL);
+	if (!pdm_priv)
+		return -ENOMEM;
+
+	pdm_priv->dev = dev;
+
+	sprop = of_get_property(np, "zhihe,sel", NULL);
+	if (sprop) 
+		strcpy(pdm_priv->name, sprop);
+
+	iprop = of_get_property(np, "zhihe,dma_maxburst", NULL);
+	if (iprop)
+		pdm_priv->dma_maxburst = be32_to_cpup(iprop);
+	else
+		pdm_priv->dma_maxburst = ZHIHE_PDM_DMA_MAXBURST;
+
+	iprop = of_get_property(np, "zhihe,mclk_keepon", NULL);
+	if (iprop)
+		pdm_priv->mclk_keepon = be32_to_cpup(iprop);
+	else
+		pdm_priv->mclk_keepon = false;
+
+	iprop = of_get_property(np, "zhihe,gain_dB", NULL);
+	if (iprop)
+		pdm_priv->gain_dB = be32_to_cpup(iprop);
+	else
+		pdm_priv->gain_dB = ZHIHE_PDM_GAIN_DEFAULT;
+
+	ret = of_property_read_u32_array(np, "zhihe,cic_offset",
+					 pdm_priv->cic_offset, CIC_OFFSET_CNT);
+	if (ret == 0)
+		pdm_priv->cic_offset_en = true;
+	else
+		pdm_priv->cic_offset_en = false;
+
+	dev_set_drvdata(&pdev->dev, pdm_priv);
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+
+	if (pdm_probe_flag) {
+		pdm_priv->regs = host_priv->regs;
+		pdm_priv->regmap = host_priv->regmap;
+		pdm_priv->sys_regmap = host_priv->sys_regmap;
+	} else {
+		pdm_probe_flag = true;
+		host_priv = pdm_priv;
+
+		pdm_priv->regs = devm_ioremap_resource(dev, res);
+		if (IS_ERR(pdm_priv->regs))
+			return PTR_ERR(pdm_priv->regs);
+
+		pdm_priv->regmap = devm_regmap_init_mmio(&pdev->dev, 
+							 pdm_priv->regs,
+							 &zhihe_pdm_regmap_config);
+		if (IS_ERR(pdm_priv->regmap)) {
+			dev_err(&pdev->dev, "Failed to initialise managed register map\n");
+			return PTR_ERR(pdm_priv->regmap);
+		}
+
+		pdm_priv->sys_regmap = syscon_regmap_lookup_by_phandle(np, "zhihe,peri1-sys");
+		if (IS_ERR(pdm_priv->sys_regmap)) {
+			dev_err(&pdev->dev, "Failed to get syscon regmap\n");
+			return PTR_ERR(pdm_priv->sys_regmap);
+		}
+
+		irq = platform_get_irq(pdev, 0);
+		if (!res || (int)irq <= 0)
+			return -ENODEV;
+
+		/* Prepare pdm clocks */
+		pdm_priv->mclk = devm_clk_get(&pdev->dev, "mclk");
+		if (IS_ERR(pdm_priv->mclk)) {
+			dev_err(&pdev->dev, "Can't retrieve pdm mclk\n");
+			return PTR_ERR(pdm_priv->mclk);
+		}
+
+		pdm_priv->pclk = devm_clk_get(&pdev->dev, "pclk");
+		if (IS_ERR(pdm_priv->pclk)) {
+			dev_err(&pdev->dev, "Can't retrieve pdm  pclk\n");
+			return PTR_ERR(pdm_priv->pclk);
+		}
+
+		if (pdm_priv->mclk_keepon) {
+			ret = clk_prepare_enable(pdm_priv->pclk);
+			if (ret) {
+				dev_err(&pdev->dev, "pclk enable failed %d\n", ret);
+				return ret;
+			}
+		}
+
+		/* Prepare pdm resets */
+		pdm_priv->resets = devm_reset_control_array_get_exclusive(&pdev->dev);
+		if (IS_ERR(pdm_priv->resets)) {
+			dev_err(&pdev->dev, "Can't retrieve pdm rst\n");
+			return PTR_ERR(pdm_priv->resets);
+		}
+		reset_control_deassert(pdm_priv->resets);
+
+		zhihe_pdm_reg_init(pdm_priv);
+
+		/* PM enable */
+		pm_runtime_set_suspended(&pdev->dev);
+		pm_runtime_enable(&pdev->dev);
+	}
+
+	pdm_priv->dma_params_rx.addr_width = DMA_SLAVE_BUSWIDTH_4_BYTES;
+	pdm_priv->dma_params_rx.maxburst = pdm_priv->dma_maxburst;
+	
+	if (!strcmp(pdm_priv->name, AUDIO_PDM0))
+		pdm_priv->dma_params_rx.addr = res->start + CP_FIFO0_L;	
+	else if (!strcmp(pdm_priv->name, AUDIO_PDM1))
+		pdm_priv->dma_params_rx.addr = res->start + CP_FIFO0_R;
+	else if (!strcmp(pdm_priv->name, AUDIO_PDM2))
+		pdm_priv->dma_params_rx.addr = res->start + CP_FIFO1_L;
+	else if (!strcmp(pdm_priv->name, AUDIO_PDM3))
+		pdm_priv->dma_params_rx.addr = res->start + CP_FIFO1_R;
+	else if (!strcmp(pdm_priv->name, AUDIO_PDM4))
+		pdm_priv->dma_params_rx.addr = res->start + CP_FIFO2_L;
+	else if (!strcmp(pdm_priv->name, AUDIO_PDM5))
+		pdm_priv->dma_params_rx.addr = res->start + CP_FIFO2_R;
+	else if (!strcmp(pdm_priv->name, AUDIO_PDM6))
+		pdm_priv->dma_params_rx.addr = res->start + CP_FIFO3_L;
+	else if (!strcmp(pdm_priv->name, AUDIO_PDM7))
+		pdm_priv->dma_params_rx.addr = res->start + CP_FIFO3_R;
+	else {
+		dev_err(&pdev->dev, 
+			"False audio dai link name %s !\n", 
+			pdm_priv->name);
+		return -ENODEV;
+	}
+
+	dma_pcfg = devm_kzalloc(&pdev->dev, sizeof(*dma_pcfg), GFP_KERNEL);
+	if (!dma_pcfg) {
+		ret = -ENOMEM;
+		goto err_pm_disable;
+	}
+	dma_pcfg->src_addr_incr = false;
+	dma_pcfg->src_fixed_burst = 1;
+
+	pdm_priv->dma_params_rx.peripheral_config = (void *)dma_pcfg;
+	pdm_priv->dma_params_rx.peripheral_size = sizeof(*dma_pcfg);
+
+	ret = devm_snd_dmaengine_pcm_register(&pdev->dev, NULL, 0);
+	if (ret) {
+		dev_err(dev, "zhihe_pcm_dma_init error\n");
+		goto err_pm_disable;
+	}
+
+	ret = devm_snd_soc_register_component(&pdev->dev, 
+					      &zhihe_pdm_soc_component,
+					      zhihe_pdm_soc_dai, 
+					      ARRAY_SIZE(zhihe_pdm_soc_dai));
+	if (ret < 0) {
+		dev_err(&pdev->dev, "Could not register PCM\n");
+		goto err_pm_disable;
+	}
+
+	if (pdm_priv->mclk_keepon) {
+		clk_prepare_enable(pdm_priv->mclk);
+	}
+
+	return 0;
+
+err_pm_disable:
+	pm_runtime_disable(&pdev->dev);
+	clk_disable_unprepare(pdm_priv->pclk);
+	clk_disable_unprepare(pdm_priv->mclk);
+	return ret;
+}
+
+static void zhihe_pdm_remove(struct platform_device *pdev)
+{
+	struct zhihe_pdm_priv *pdm_priv = dev_get_drvdata(&pdev->dev);
+
+	regmap_update_bits(pdm_priv->sys_regmap, PERI1_PDM_TDM_CSR,
+			   PDM_VAD_EN_MSK, 0);
+
+	pm_runtime_disable(&pdev->dev);
+	if (!pm_runtime_status_suspended(&pdev->dev))
+		zhihe_pdm_runtime_suspend(&pdev->dev);
+
+	clk_disable_unprepare(pdm_priv->pclk);
+	clk_disable_unprepare(pdm_priv->mclk);
+}
+
+static const struct dev_pm_ops zhihe_pdm_pm_ops = {
+	SET_RUNTIME_PM_OPS(zhihe_pdm_runtime_suspend,
+			   zhihe_pdm_runtime_resume,
+			   NULL)
+	SET_SYSTEM_SLEEP_PM_OPS(zhihe_pdm_suspend, zhihe_pdm_resume)
+};
+
+static struct platform_driver zhihe_pdm_driver = {
+	.driver = {
+		.name	= "zhihe-pdm-audio",
+		.pm	= &zhihe_pdm_pm_ops,
+		.of_match_table = of_match_ptr(zhihe_pdm_of_match),
+	},
+	.probe	= zhihe_pdm_probe,
+	.remove	= zhihe_pdm_remove,
+};
+
+module_platform_driver(zhihe_pdm_driver);
+
+MODULE_AUTHOR("Anonymous <anonymous@zhcomputing.com>");
+MODULE_DESCRIPTION("Zhihe PDM Audio Driver");
+MODULE_LICENSE("GPL v2");
diff --git a/sound/soc/zhihe/zhihe-pdm.h b/sound/soc/zhihe/zhihe-pdm.h
new file mode 100644
index 0000000000000..07d16590a507f
--- /dev/null
+++ b/sound/soc/zhihe/zhihe-pdm.h
@@ -0,0 +1,111 @@
+#ifndef _ZHIHE_PDM_H
+#define _ZHIHE_PDM_H
+
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/workqueue.h>
+#include <linux/scatterlist.h>
+#include <linux/sh_dma.h>
+#include <linux/slab.h>
+#include <linux/spinlock.h>
+#include <linux/module.h>
+#include <linux/workqueue.h>
+#include <sound/soc.h>
+#include <sound/pcm_params.h>
+#include <sound/pcm.h>
+#include <sound/core.h>
+#include <sound/initval.h>
+#include <sound/dmaengine_pcm.h>
+
+#include "zhihe-pcm.h"
+
+/* PDM REGISTER */
+#define CP_VAD_CTRL			(0x00)
+#define CP_ZCR_TH_CTRL			(0x04)
+#define CP_STE_HTH_CTRL			(0x08)
+#define CP_STE_LTH_CTRL			(0x0C)
+#define	CP_VAD_INTR_MFLAG		(0x10)
+#define	CP_VAD_INTR_CLR			(0x14)
+#define	CP_VAD_INTR_FLAG		(0x18)
+#define	CP_VAD_INTR_MASK		(0x1C)
+#define CP_DAI_EN			(0x20)
+#define CP_DAI_CTRL			(0x24)
+#define CP_FIFO_CNT			(0x28)
+#define CP_FIFO_TH_CTRL			(0x2C)
+#define CP_FIFO_INTR_MFLAG		(0x30)
+#define CP_FIFO_INTR_CLR		(0x34)
+#define CP_FIFO_INTR_FLAG		(0x38)
+#define CP_FIFO_INTR_MASK		(0x3C)
+#define CP_CIC_L_ST_OFFSET		(0x40)
+#define CP_CIC_L_LP_OFFSET		(0x44)
+#define CP_CIC_R_ST_OFFSET		(0x48)
+#define CP_CIC_R_LP_OFFSET		(0x4C)
+#define CP_FIFO0_L 			(0x50)
+#define CP_FIFO0_R 			(0x54)
+#define CP_FIFO1_L			(0x58)
+#define CP_FIFO1_R			(0x5C)
+#define CP_FIFO2_L			(0x60)
+#define CP_FIFO2_R			(0x64)
+#define CP_FIFO3_L			(0x68)
+#define CP_FIFO3_R			(0x6C)
+#define CP_VAD_IP_ID			(0x74)
+
+/* VADCTRL */
+#define VADCTRL_PDM_EN_MSK		GENMASK(1, 0)
+#define VADCTRL_PDM_EN_POS		(0U)
+#define VADCTRL_VAD_EN_SEL		(0x1U << VADCTRL_PDM_EN_POS)
+#define VADCTRL_DATA_TRANS_EN_SEL	(0x2U << VADCTRL_PDM_EN_POS)
+#define VADCTRL_CH_EN_MSK		GENMASK(7, 4)
+#define VADCTRL_CH_EN_POS		(4U)
+#define VADCTRL_CH0_EN			(0x1U << VADCTRL_CH_EN_POS)
+#define VADCTRL_CH1_EN			(0x2U << VADCTRL_CH_EN_POS)
+#define VADCTRL_CH2_EN			(0x4U << VADCTRL_CH_EN_POS)
+#define VADCTRL_CH3_EN			(0x8U << VADCTRL_CH_EN_POS)
+#define VADCTRL_ALL_CH_EN		(0xFU << VADCTRL_CH_EN_POS)
+
+/* DAI_EN */
+#define DAI_EN_MSK 			BIT(0)
+#define DAI_EN_POS			(0U)
+#define DAI_EN_SEL 			(0x1U << DAI_EN_POS)
+
+/* DAI_CTRL */
+#define DAI_LP_GAIN_MSK			GENMASK(22, 20)
+#define DAI_LP_GAIN_POS			(20U)
+#define DAI_ST_GAIN_MSK			GENMASK(26, 24)
+#define DAI_ST_GAIN_POS			(24U)
+
+/* PERI1 SYSREG */
+#define PERI1_PDM_TDM_CSR		(0x0C)
+#define PERI1_DMA_REUSE_CSR		(0x10)
+
+/* PDM CSR */
+#define PDM_VAD_EN_MSK			BIT(0)
+#define PDM_VAD_EN_POS			(0U)
+#define PDM_VAD_EN_SEL			(0x1U << PDM_VAD_EN_POS)
+
+/* DMA REUSE CSR */
+#define PDM_DMA_REUSE_MSK		GENMASK(5, 0)
+#define PDM_DMA_REUSE_POS		(0U)
+#define PDM_DMA_REUSE_SEL		(0x2AU << PDM_DMA_REUSE_POS)
+
+#define CIC_OFFSET_CNT 4
+
+struct zhihe_pdm_priv {
+	void __iomem *regs;
+	struct device *dev;
+	struct regmap *regmap;
+	struct regmap *sys_regmap;
+	struct clk *mclk;
+	struct clk *pclk;
+	struct reset_control *resets;
+	struct snd_dmaengine_dai_dma_data dma_params_rx;
+
+	char name[16];
+	u32 dma_maxburst;
+	u32 mclk_keepon;
+	u32 gain_dB;
+	u32 cic_offset[CIC_OFFSET_CNT];
+	bool cic_offset_en;
+};
+
+#endif /* _ZHIHE_PDM_H */
diff --git a/sound/soc/zhihe/zhihe-tdm.c b/sound/soc/zhihe/zhihe-tdm.c
new file mode 100644
index 0000000000000..8693332d84d66
--- /dev/null
+++ b/sound/soc/zhihe/zhihe-tdm.c
@@ -0,0 +1,668 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Zhihe audio TDM audio support
+ *
+ * Copyright (C) 2024 Zhihe Computing Technology (Shenzhen) Co., Ltd..
+ *
+ * Author: Anonymous <anonymous@zhcomputing.com>
+ */
+
+#include <linux/dma/dw-axi-dma.h>
+#include <linux/mfd/syscon.h>
+#include <linux/module.h>
+#include <linux/of_device.h>
+#include <linux/pm_runtime.h>
+#include <linux/slab.h>
+#include <sound/initval.h>
+#include <sound/pcm_params.h>
+#include <linux/reset.h>
+
+#include "zhihe-pcm.h"
+#include "zhihe-tdm.h"
+
+static int is_tdm_probe		= 0;
+static int is_set_fmt_dai	= 0;
+static int slot_use_cnt		= 0;
+
+struct zhihe_tdm_priv *tdm_host_priv;
+
+static u32 zhihe_special_sample_rates[] = { 11025, 22050, 44100, 88200, 176400 };
+
+static int zhihe_tdm_dai_probe(struct snd_soc_dai *dai)
+{
+	struct zhihe_tdm_priv *tdm_priv = snd_soc_dai_get_drvdata(dai);
+
+	if (!tdm_priv)
+		return -EIO;
+
+	snd_soc_dai_init_dma_data(dai, NULL, &tdm_priv->dma_params_rx);
+
+	return 0;
+}
+
+static void zhihe_tdm_snd_rxctrl(struct zhihe_tdm_priv *chip, u32 on)
+{
+	regmap_write(chip->regmap, TDM_DMACTL, DMACTL_DMAEN_SEL(on));
+	regmap_write(chip->regmap, TDM_TDMEN, TDMCTL_TDMEN_SEL(on));
+}
+
+static int zhihe_tdm_dai_trigger(struct snd_pcm_substream *substream, int cmd,
+				 struct snd_soc_dai *dai)
+{
+	int ret = 0;
+	struct zhihe_tdm_priv *tdm_priv = snd_soc_dai_get_drvdata(dai);
+
+	if (!tdm_priv || !tdm_priv->regmap)
+		return -EINVAL;
+
+	spin_lock(&tdm_priv->zhihe_tdm_lock);
+
+	switch(cmd) {
+	case SNDRV_PCM_TRIGGER_START:
+	case SNDRV_PCM_TRIGGER_RESUME:
+	case SNDRV_PCM_TRIGGER_PAUSE_RELEASE:
+		if (!slot_use_cnt)
+			zhihe_tdm_snd_rxctrl(tdm_priv, 1);
+		++slot_use_cnt;
+		break;
+	case SNDRV_PCM_TRIGGER_STOP:
+		--slot_use_cnt;
+		/* work around for DMAC stop issue. */
+		dmaengine_terminate_async(snd_dmaengine_pcm_get_chan(substream));
+		if (!slot_use_cnt)
+			zhihe_tdm_snd_rxctrl(tdm_priv, 0);
+		break;
+	case SNDRV_PCM_TRIGGER_PAUSE_PUSH:
+	case SNDRV_PCM_TRIGGER_SUSPEND:
+		--slot_use_cnt;
+		/* work around for DMAC stop issue. */
+		dmaengine_pause(snd_dmaengine_pcm_get_chan(substream));
+		if (!slot_use_cnt)
+			zhihe_tdm_snd_rxctrl(tdm_priv, 0);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	spin_unlock(&tdm_priv->zhihe_tdm_lock);
+
+	return ret;
+}
+
+static int zhihe_tdm_set_fmt_dai(struct snd_soc_dai *dai, unsigned int fmt)
+{
+	struct zhihe_tdm_priv *tdm_priv = snd_soc_dai_get_drvdata(dai);
+	int ret = 0;
+
+	if (!tdm_priv->regmap)
+		return -EINVAL;
+
+	if (is_set_fmt_dai)
+		return 0;
+
+	pm_runtime_resume_and_get(tdm_priv->dev);
+
+	spin_lock(&tdm_priv->zhihe_tdm_lock);
+
+	switch (fmt & SND_SOC_DAIFMT_FORMAT_MASK) {
+	case SND_SOC_DAIFMT_DSP_A:
+	case SND_SOC_DAIFMT_DSP_B:
+		break;
+	default:
+		pr_err("Unknown fmt dai\n");
+		ret = -EINVAL;
+		goto finish;
+	}
+
+	/* CPU CLK in FUNC "snd_soc_daifmt_clock_provider_flipped" is flipped */
+	switch (fmt & SND_SOC_DAIFMT_CLOCK_PROVIDER_MASK) {
+	case SND_SOC_DAIFMT_BP_FP:
+		/* CPU MASTER */
+		tdm_priv->mode = TDM_MODE_MASTER;
+		break;
+	case SND_SOC_DAIFMT_BC_FC:
+		/* CPU SLAVE */
+		tdm_priv->mode = TDM_MODE_SLAVE;
+		break;
+	default:
+		pr_err("Unknown clock provider dai\n");
+		ret = -EINVAL;
+		goto finish;
+	}
+
+	regmap_update_bits(tdm_priv->regmap, TDM_TDMCTL, TDMCTL_MODE_MSK,
+			   TDMCTL_MODE_SEL(tdm_priv->mode));
+
+	// bclk发送数据 0：上升沿 1：下降沿
+	regmap_update_bits(tdm_priv->regmap, TDM_TDMCTL, TDMCTL_SPEDGE_MSK,
+			   TDMCTL_SPEDGE_SEL(tdm_priv->spedge));
+
+	// tdm fifo dma 阈值
+	regmap_update_bits(tdm_priv->regmap, TDM_DMADL, DMACTL_DMADL_MSK,
+			   DMACTL_DMADL_SEL(0));
+
+	is_set_fmt_dai++;
+
+finish:
+	spin_unlock(&tdm_priv->zhihe_tdm_lock);
+
+	pm_runtime_put_sync(tdm_priv->dev);
+
+	return ret;
+}
+
+static void zhihe_tdm_set_div(struct zhihe_tdm_priv *chip, u32 sample_rate,
+			      u32 width)
+{
+	bool is_divclk1 = false;
+	u32 src_clk;
+	u32 div0;
+	int i;
+
+	clk_set_rate(chip->sclk, AUDIO_DIVCLK0);
+
+	for (i = 0; i < ARRAY_SIZE(zhihe_special_sample_rates); ++i) {
+		if (zhihe_special_sample_rates[i] == sample_rate) {
+			clk_set_rate(chip->sclk, AUDIO_DIVCLK1);
+			is_divclk1 = true;
+			break;
+		}
+	}
+
+	/**
+	 * audio_divclk1 for 44.1k fsb.
+	 * audio_divclk0 for 48k fsb.
+	 */
+	src_clk = is_divclk1 ? AUDIO_DIVCLK1 : AUDIO_DIVCLK0;
+
+	div0 = src_clk / (sample_rate * (width * chip->slots));
+	regmap_update_bits(chip->regmap, TDM_DIV0_LEVEL, TDMCTL_DIV0_MASK,
+			   div0);
+}
+
+static int zhihe_tdm_dai_startup(struct snd_pcm_substream *substream,
+				 struct snd_soc_dai *dai)
+{
+	struct zhihe_tdm_priv *tdm_priv =  snd_soc_dai_get_drvdata(dai);
+	unsigned int dma_reuse;
+
+	if (!tdm_priv->sys_regmap)
+		return -EINVAL;
+
+	regmap_read(tdm_priv->sys_regmap, PERI1_DMA_REUSE_CSR, &dma_reuse);
+	if (dma_reuse != TDM_DMA_REUSE_SEL)
+		regmap_write(tdm_priv->sys_regmap, PERI1_DMA_REUSE_CSR, TDM_DMA_REUSE_SEL);
+
+	return 0;
+}
+
+static int zhihe_tdm_dai_hw_params(struct snd_pcm_substream *substream,
+				   struct snd_pcm_hw_params *params,
+				   struct snd_soc_dai *dai)
+{
+	struct zhihe_tdm_priv *tdm_priv =  snd_soc_dai_get_drvdata(dai);
+	u32 datawth;
+	u32 chn_num;
+	u32 sample_rate;
+	u32 width;
+
+	if (!tdm_priv || !tdm_priv->regmap)
+		return -EINVAL;
+
+	sample_rate = params_rate(params);
+
+	switch(params_format(params)) {
+	case SNDRV_PCM_FORMAT_S16_LE:
+		/* TDMCTL_DATAWTH_16BIT. */
+		datawth = TDMCTL_DATAWTH_16BIT_PACKED;
+		width = ZHIHE_TDM_BITWTH_16;
+		break;
+	case SNDRV_PCM_FORMAT_S24_LE:
+	case SNDRV_PCM_FORMAT_S32_LE:
+	case SNDRV_PCM_FMTBIT_FLOAT_LE:
+		datawth = TDMCTL_DATAWTH_32BIT;
+		width = ZHIHE_TDM_BITWTH_32;
+		break;
+	default:
+		pr_err("Unknown data format\n");
+		return -EINVAL;
+	}
+
+	switch(tdm_priv->slots) {
+	case 2:
+		chn_num = TDMCTL_CHNUM_2;
+		break;
+	case 4:
+		chn_num = TDMCTL_CHNUM_4;
+		break;
+	case 6:
+		chn_num = TDMCTL_CHNUM_6;
+		break;
+	case 8:
+		chn_num = TDMCTL_CHNUM_8;
+		break;
+	default:
+		pr_err("Not support slot num\n");
+		return -EINVAL;
+	}
+
+	regmap_update_bits(tdm_priv->regmap, TDM_TDMCTL, TDMCTL_DATAWTH_MSK,
+			   TDMCTL_DATAWTH_SEL(datawth));
+
+	regmap_update_bits(tdm_priv->regmap, TDM_TDMCTL, TDMCTL_CHNUM_MSK,
+			   TDMCTL_CHNUM_SEL(chn_num));
+
+	zhihe_tdm_set_div(tdm_priv, sample_rate, width);
+
+	return 0;
+}
