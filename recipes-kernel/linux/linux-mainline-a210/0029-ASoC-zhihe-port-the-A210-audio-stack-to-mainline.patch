+static int es7210_multi_chips_write(u8 reg, unsigned char value)
+{
+        u8 i;
+
+        for (i = 0; i < ADC_DEV_MAXNUM; i++) {
+                es7210_write(reg, value, i2c_clt1[i]);
+        }
+
