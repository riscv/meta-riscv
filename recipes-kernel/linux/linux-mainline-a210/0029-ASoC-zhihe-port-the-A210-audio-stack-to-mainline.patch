+	[ZHIHE_I2S2]		= I2S_DR0,
+	[ZHIHE_I2S3_8CH_SD0]	= I2S_DR0,
+	[ZHIHE_I2S3_8CH_SD1]	= I2S_DR1,
+	[ZHIHE_I2S3_8CH_SD2]	= I2S_DR2,
+	[ZHIHE_I2S3_8CH_SD3]	= I2S_DR3,
+	[ZHIHE_AP_I2S]		= I2S_DR0,
+};
+
+static int zhihe_i2s_init_drvdata(struct zhihe_i2s_priv *i2s_priv,
+				  enum zhihe_i2s_id id)
+{
+	if (id >= ZHIHE_I2S_MAX) {
+		dev_err(i2s_priv->dev, "invalid i2s id: %d\n", id);
+		return -EINVAL;
+	}
+
+	i2s_priv->id = id;
+	i2s_priv->tx_dr = zhihe_i2s_dr[id];
+	i2s_priv->rx_dr = zhihe_i2s_dr[id];
+	snprintf(i2s_priv->name, sizeof(i2s_priv->name), "%s", zhihe_i2s_names[id]);
+	snprintf(i2s_priv->i2s_dai_name, sizeof(i2s_priv->i2s_dai_name),
+		 "pcm-%s-dai", zhihe_i2s_names[id]);
+	snprintf(i2s_priv->hdmi_dai_name, sizeof(i2s_priv->hdmi_dai_name),
+		 "pcm-%s-hdmi-dai", zhihe_i2s_names[id]);
+	return 0;
+}
+
+static const struct of_device_id zhihe_i2s_of_match[] = {
+	{ .compatible = "zhihe,i2s" },
+	{ .compatible = "xuantie,th1520-i2s" },
+	{},
+};
+MODULE_DEVICE_TABLE(of, zhihe_i2s_of_match);
+
+static ssize_t zhihe_i2s_show(struct device *dev, struct device_attribute *attr,
+			      char *buf)
+{
+	struct zhihe_i2s_priv *i2s_priv = dev_get_drvdata(dev);
+	unsigned int value, reg;
+
+	for (reg = I2S_IISEN; reg <= I2S_DR3; reg += ZHIHE_I2S_REG_STRIDE) {
+		regmap_read(i2s_priv->regmap, reg, &value);
+		printk("i2s reg[0x%x]=0x%x\n", reg, value);
+	}
+
+	if (!zhihe_i2s_is_ap(i2s_priv->id)) {
+		for (reg = 0; reg <= 0xfc; reg += 0x4) {
+			regmap_read(i2s_priv->audio_cpr_regmap, reg, &value);
+			printk("cpr reg[0x%x]=0x%x\n", reg, value);
+		}
+	}
+
+	return 0;
+}
+
+static ssize_t zhihe_i2s_overflow_show(struct device *dev,
+				       struct device_attribute *attr, char *buf)
+{
+	struct zhihe_i2s_priv *i2s_priv = dev_get_drvdata(dev);
+	unsigned int sr, rxflr, risr, isr;
+	unsigned int icr_val = 0;
+	int len = 0;
+	int n;
+
+	if (!i2s_priv->regmap)
+		return sysfs_emit(buf, "regmap is NULL\n");
+
+	regmap_read(i2s_priv->regmap, I2S_SR, &sr);
+	regmap_read(i2s_priv->regmap, I2S_RXFLR, &rxflr);
+	regmap_read(i2s_priv->regmap, I2S_RISR, &risr);
+	regmap_read(i2s_priv->regmap, I2S_ISR, &isr);
+
+	len += sysfs_emit_at(buf, len, "---- RX FIFO Status ----\n");
+	len += sysfs_emit_at(buf, len,
+		"FIFO (Full-NotEmpty): F0=(%d-%d) F1=(%d-%d) F2=(%d-%d) F3=(%d-%d)\n",
+		!!(sr & SR_RFF0_Msk), !!(sr & SR_RFNE0_Msk),
+		!!(sr & SR_RFF1_Msk), !!(sr & SR_RFNE1_Msk),
+		!!(sr & SR_RFF2_Msk), !!(sr & SR_RFNE2_Msk),
+		!!(sr & SR_RFF3_Msk), !!(sr & SR_RFNE3_Msk));
+	len += sysfs_emit_at(buf, len,
+		"FIFO Level: CH0=%u CH1=%u CH2=%u CH3=%u\n",
+		RXFLR_CH_LEVEL(rxflr, 0), RXFLR_CH_LEVEL(rxflr, 1),
+		RXFLR_CH_LEVEL(rxflr, 2), RXFLR_CH_LEVEL(rxflr, 3));
+	len += sysfs_emit_at(buf, len, "RX Busy: %d\n", !!(sr & SR_RXBUSY_Msk));
+
+	len += sysfs_emit_at(buf, len, "---- RX Overflow ----\n");
+	len += sysfs_emit_at(buf, len,
+		"Raw:    CH0=%d CH1=%d CH2=%d CH3=%d\n",
+		!!(risr & (1 << RXOIR_CH_BIT(0))),
+		!!(risr & (1 << RXOIR_CH_BIT(1))),
+		!!(risr & (1 << RXOIR_CH_BIT(2))),
+		!!(risr & (1 << RXOIR_CH_BIT(3))));
+	len += sysfs_emit_at(buf, len,
+		"Masked: CH0=%d CH1=%d CH2=%d CH3=%d\n",
+		!!(isr & (1 << RXOIR_CH_BIT(0))),
+		!!(isr & (1 << RXOIR_CH_BIT(1))),
+		!!(isr & (1 << RXOIR_CH_BIT(2))),
+		!!(isr & (1 << RXOIR_CH_BIT(3))));
+
+	/* Accumulate overflow count from raw status and clear per-channel */
+	for (n = 0; n < 4; n++) {
+		if (risr & (1 << RXOIR_CH_BIT(n))) {
+			icr_val |= (1 << RXOIC_CH_BIT(n));
+		}
+	}
+	if (icr_val)
+		regmap_write(i2s_priv->regmap, I2S_ICR, icr_val);
+
+	return len;
+}
+
+static DEVICE_ATTR(registers, 0444, zhihe_i2s_show, NULL);
+static DEVICE_ATTR(overflow_status, 0444, zhihe_i2s_overflow_show, NULL);
+
+static struct attribute *zhihe_i2s_debug_attrs[] = {
+	&dev_attr_registers.attr,
+	&dev_attr_overflow_status.attr,
+	NULL,
+};
+
+static struct attribute_group zhihe_i2s_debug_attr_group = {
+	.name	= "zhihe_i2s_debug",
+	.attrs	= zhihe_i2s_debug_attrs,
+};
+
+static int zhihe_i2s_probe(struct platform_device *pdev)
+{
+	struct device_node *np = pdev->dev.of_node;
+	struct zhihe_i2s_priv *i2s_priv;
+	struct snd_soc_dai_driver *dai;
+	struct resource *res;
+	struct axi_dma_peripheral_config *dma_pcfg;
+	unsigned int val;
+	int id;
+	int ret;
+
+	i2s_priv = devm_kzalloc(&pdev->dev, sizeof(*i2s_priv), GFP_KERNEL);
+	if (!i2s_priv)
+		return -ENOMEM;
+
+	platform_set_drvdata(pdev, i2s_priv);
+
+	spin_lock_init(&i2s_priv->zhihe_i2s_lock);
+	i2s_priv->dev = &pdev->dev;
+
+	/* Choose board by dts. */
+	if (of_property_read_bool(np, "snd-soc-zhihe-a210"))
+		i2s_priv->board = ZHIHE_A210;
+	else if (of_property_read_bool(np, "snd-soc-zhihe-a200"))
+		i2s_priv->board = ZHIHE_A200;
+	else
+		i2s_priv->board = ZHIHE_BOARD_DEFAULT;
+
+	/* Read i2s id from DTS */
+	ret = of_property_read_u32(np, "zhihe,i2s-id", &id);
+	if (ret) {
+		dev_err(&pdev->dev, "missing zhihe,i2s-id property\n");
+		return ret;
+	}
+
+	ret = zhihe_i2s_init_drvdata(i2s_priv, id);
+	if (ret)
+		return ret;
+
+	/* Choose active level of left/right channel. */
+	if (of_property_read_bool(np, "alolrc-high"))
+		i2s_priv->alolrc_high = true;
+
+	/* RX channel choose left channel in mono mode. */
+	if (of_property_read_bool(np, "rx-ch-left"))
+		i2s_priv->rx_ch_left = true;
+
+	/* multi-channels support */
+	if (!of_property_read_u32(np, "multi-channels", &val))
+		if (val == 2 || val == 4 || val == 6 || val == 8)
+			i2s_priv->ch_cnt = val;
+		else {
+			dev_err(i2s_priv->dev, "Invalid channel count: %u\n", val);
+			return -EINVAL;
+		}
+	else
+		i2s_priv->ch_cnt = 2;
+
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+
+	if (zhihe_i2s_is_i2s3(i2s_priv->id) && i2s_priv->id != ZHIHE_I2S3_8CH_SD0) {
+		i2s_priv->regs = NULL;
+		i2s_priv->regmap = NULL;
+	} else {
+		i2s_priv->regs = devm_ioremap_resource(&pdev->dev, res);
+		if (IS_ERR(i2s_priv->regs))
+			return PTR_ERR(i2s_priv->regs);
+
+		i2s_priv->regmap = devm_regmap_init_mmio(&pdev->dev, i2s_priv->regs,
+							 &zhihe_i2s_regmap_config);
+		if (IS_ERR(i2s_priv->regmap)) {
+			dev_err(&pdev->dev,
+				"Failed to initialise managed register map\n");
+			return PTR_ERR(i2s_priv->regmap);
+		}
+
+		if (i2s_priv->board == ZHIHE_A200) {
+			/* set audio-cpr regmap without ap_i2s */
+			if (!zhihe_i2s_is_ap(i2s_priv->id)) {
+				i2s_priv->audio_cpr_regmap =
+					syscon_regmap_lookup_by_phandle(np, "audio-cpr-regmap");
+				if (IS_ERR(i2s_priv->audio_cpr_regmap)) {
+					dev_err(&pdev->dev,
+						"cannot find regmap for audio cpr register\n");
+					return PTR_ERR(i2s_priv->audio_cpr_regmap);
+				}
+				regmap_update_bits(i2s_priv->audio_cpr_regmap,
+						   CPR_PERI_DIV_SEL_REG,
+						   CPR_AUDIO_DIV1_SEL_MSK,
+						   CPR_AUDIO_DIV1_SEL(5));
+				/* enable i2s sync */
+				regmap_update_bits(i2s_priv->audio_cpr_regmap,
+						   CPR_PERI_CTRL_REG,
+						   CPR_I2S_SYNC_MSK,
+						   CPR_I2S_SYNC_EN);
+			} else
+				i2s_priv->audio_cpr_regmap = NULL;
+		}
+
+		/* set reset */
+		i2s_priv->rst = devm_reset_control_get_optional_exclusive(&pdev->dev, NULL);
+		if (IS_ERR(i2s_priv->rst))
+			return PTR_ERR(i2s_priv->rst);
+
+		/* prepare APB clocks */
+		i2s_priv->pclk = devm_clk_get(&pdev->dev, "pclk");
+		if (IS_ERR(i2s_priv->pclk)) {
+			dev_err(&pdev->dev, "Can't retrieve i2s bus clock\n");
+			return PTR_ERR(i2s_priv->pclk);
+		}
+
+		if (i2s_priv->board == ZHIHE_A210) {
+			/* prepare source clocks */
+			i2s_priv->sclk = devm_clk_get(&pdev->dev, "sclk");
+			if (IS_ERR(i2s_priv->sclk)) {
+				dev_err(&pdev->dev, "Can't retrieve i2s sclk clock\n");
+				ret = PTR_ERR(i2s_priv->sclk);
+				goto err_clk;
+			}
+		}
+
+		/* Request IRQ. */
+		i2s_priv->irq = platform_get_irq(pdev, 0);
+		if (i2s_priv->irq <= 0) {
+			ret = i2s_priv->irq < 0 ? i2s_priv->irq : -ENODEV;
+			goto err_clk;
+		}
+
+		pm_runtime_enable(&pdev->dev);
+		if (i2s_priv->board == ZHIHE_A200) {
+			/* clk gate is enabled by hardware as default register value */
+			pm_runtime_resume_and_get(&pdev->dev);
+			pm_runtime_put_sync(&pdev->dev);
+		}
+
+		/* create sysfs interface */
+		ret = sysfs_create_group(&pdev->dev.kobj,
+					&zhihe_i2s_debug_attr_group);
+		if (ret) {
+			dev_err(&pdev->dev, "failed to create attr group\n");
+			goto err_pm_disable;
+		}
+
+		/* CSR transmit channel config, only i2s3 on A210 is supported */
+		if (i2s_priv->id == ZHIHE_I2S3_8CH_SD0) {
+			i2s_priv->sys_csr = devm_platform_ioremap_resource(pdev, 1);
+			if (!i2s_priv->sys_csr)
+				dev_warn(&pdev->dev, "failed to map sys_csr\n");
+			else
+				i2s_priv->hdmi_connected =
+					is_csr_available(np, TRANSFER_PORT_HDMI, -1);
+		}
+	}
+
+	i2s_priv->dma_params_tx.addr_width = DMA_SLAVE_BUSWIDTH_4_BYTES;
+	i2s_priv->dma_params_rx.addr_width = DMA_SLAVE_BUSWIDTH_4_BYTES;
+	i2s_priv->dma_params_tx.maxburst = ZHIHE_I2S_DMA_MAX_BURST;
+	i2s_priv->dma_params_rx.maxburst = ZHIHE_I2S_DMA_MAX_BURST;
+	i2s_priv->dma_params_tx.addr = res->start + i2s_priv->tx_dr;
+	i2s_priv->dma_params_rx.addr = res->start + i2s_priv->rx_dr;
+	if (i2s_priv->board == ZHIHE_A210) {
+		dma_pcfg = devm_kzalloc(&pdev->dev, sizeof(*dma_pcfg), GFP_KERNEL);
+		if (!dma_pcfg) {
+			ret = -ENOMEM;
+			goto err_pm_disable;
+		}
+		dma_pcfg->dst_addr_incr = false;
+		dma_pcfg->src_addr_incr = false;
+		dma_pcfg->dst_fixed_burst = ZHIHE_I2S_DMA_FIX_BURST;
+		dma_pcfg->src_fixed_burst = ZHIHE_I2S_DMA_FIX_BURST;
+
+		i2s_priv->dma_params_tx.peripheral_config = (void *)dma_pcfg;
+		i2s_priv->dma_params_tx.peripheral_size = sizeof(*dma_pcfg);
+		i2s_priv->dma_params_rx.peripheral_config = (void *)dma_pcfg;
+		i2s_priv->dma_params_rx.peripheral_size = sizeof(*dma_pcfg);
+	}
+
+	ret = devm_snd_dmaengine_pcm_register(&pdev->dev, NULL, 0);
+	if (ret) {
+		dev_err(&pdev->dev, "Could not register PCM\n");
+		goto err_pm_disable;
+	}
+
+	dai = devm_kmemdup(&pdev->dev, zhihe_i2s_soc_dai,
+			   sizeof(zhihe_i2s_soc_dai), GFP_KERNEL);
+	if (!dai) {
+		ret = -ENOMEM;
+		goto err_pm_disable;
+	}
+	dai[DAI_I2S].name = i2s_priv->i2s_dai_name;
+	dai[DAI_HDMI].name = i2s_priv->hdmi_dai_name;
+
+	ret = devm_snd_soc_register_component(&pdev->dev,
+					      &zhihe_i2s_soc_component, dai,
+					      ARRAY_SIZE(zhihe_i2s_soc_dai));
+	if (ret) {
+		dev_err(&pdev->dev, "Could not register DAI\n");
+		goto err_pm_disable;
+	}
+
+	/**
+	 * Notice: In the I2S3 interface, SD0 serves as the master channel for
+	 * register control, while SD1, SD2, and SD3 operate as slave channels.
+	 */
+	if (zhihe_i2s_is_i2s3(i2s_priv->id)) {
+		if (i2s_priv->id == ZHIHE_I2S3_8CH_SD0)
+			i2s3_host_regs = i2s_priv->regs;
+		i2s3_probe_flag++;
+
+	}
+
+	return ret;
+
+err_pm_disable:
+	pm_runtime_disable(&pdev->dev);
+
+err_clk:
+	clk_disable_unprepare(i2s_priv->pclk);
+	return ret;
+}
+
+static void zhihe_i2s_remove(struct platform_device *pdev)
+{
+	struct zhihe_i2s_priv *i2s_priv = dev_get_drvdata(&pdev->dev);
+
+	if (zhihe_i2s_is_i2s3(i2s_priv->id)) {
+		i2s3_probe_flag--;
+		if (!i2s_priv->regmap)
+			return;
+		if (i2s3_probe_flag == 0)
+			i2s3_host_regs = NULL;
+	}
+
+	pm_runtime_disable(&pdev->dev);
+	if (!pm_runtime_status_suspended(&pdev->dev))
+		zhihe_i2s_rt_suspend(&pdev->dev);
+}
+
+static const struct dev_pm_ops zhihe_i2s_pm_ops = {
+	SET_RUNTIME_PM_OPS(zhihe_i2s_rt_suspend, zhihe_i2s_rt_resume, NULL)
+	SET_SYSTEM_SLEEP_PM_OPS(zhihe_i2s_suspend, zhihe_i2s_resume)
+};
+
+static struct platform_driver zhihe_i2s_driver = {
+	.probe = zhihe_i2s_probe,
+	.remove = zhihe_i2s_remove,
+	.driver = {
+		.name = DRV_NAME,
+		.of_match_table = of_match_ptr(zhihe_i2s_of_match),
+		.pm = &zhihe_i2s_pm_ops,
+	},
+};
+module_platform_driver(zhihe_i2s_driver);
+
+MODULE_AUTHOR("Anonymous <anonymous@zhcomputing.com>");
+MODULE_DESCRIPTION("Zhihe I2S PCM Driver");
+MODULE_LICENSE("GPL v2");
+MODULE_ALIAS("platform:" DRV_NAME);
diff --git a/sound/soc/zhihe/zhihe-i2s.h b/sound/soc/zhihe/zhihe-i2s.h
new file mode 100644
index 0000000000000..8b61a2a518fa0
--- /dev/null
+++ b/sound/soc/zhihe/zhihe-i2s.h
@@ -0,0 +1,664 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Zhihe audio I2S audio support
+ *
+ * Copyright (C) 2024 Zhihe Computing Technology (Shenzhen) Co., Ltd..
+ *
+ * Author: Anonymous <anonymous@zhcomputing.com>
+ */
+
+#ifndef _ZHIHE_I2S_H
+#define _ZHIHE_I2S_H
+
+#include <linux/clk.h>
+#include <linux/device.h>
+#include <linux/io.h>
+#include <linux/regmap.h>
+#include <linux/reset.h>
+#include <linux/spinlock.h>
+#include <linux/types.h>
+#include <sound/dmaengine_pcm.h>
+#include "zhihe-a200-cpr.h"
+
+#define AP_I2S			"ap-i2s"
+#define AUDIO_I2S0		"audio-i2s0"
+#define AUDIO_I2S1		"audio-i2s1"
+#define AUDIO_I2S2		"audio-i2s2"
+
+enum zhihe_i2s_id {
+	ZHIHE_I2S0 = 0,
+	ZHIHE_I2S1,
+	ZHIHE_I2S2,
+	ZHIHE_I2S3_8CH_SD0,
+	ZHIHE_I2S3_8CH_SD1,
+	ZHIHE_I2S3_8CH_SD2,
+	ZHIHE_I2S3_8CH_SD3,
+	ZHIHE_AP_I2S,
+	ZHIHE_I2S_MAX,
+};
+
+#define IIS_SRC_CLK		294912000
+#define AUDIO_IIS_SRC0_CLK	147456000
+#define AUDIO_IIS_SRC1_CLK	135475200
+
+enum {
+	ZHIHE_A200 = 0,
+	ZHIHE_A210 = 1,
+	ZHIHE_BOARD_DEFAULT = ZHIHE_A200,
+};
+
+#define I2S_MASTER		1
+#define I2S_SLAVE		0
+
+#define DIV0_DEFAULT		1
+#define DIV3_DEFAULT		3
+
+#define MONO_SOURCE		1
+#define STEREO_CHANNEL		2
+
+#define DAI_I2S			0
+#define DAI_HDMI		1
+
+#define ZHIHE_I2S_BIT_WIDTH	32
+#define ZHIHE_I2S_REG_STRIDE	4
+#define ZHIHE_I2S_DMA_MAX_BURST	4
+#define ZHIHE_I2S_DMA_FIX_BURST	1
+
+#define I2S_DMA_TX_THRESHOLD	16
+#define I2S_DMA_RX_THRESHOLD	16
+#define I2S_DMA_RX_WATERMARK	0x4
+
+#define ZHIHE_I2S_RATES		SNDRV_PCM_RATE_8000_384000
+#define ZHIHE_I2S_FMTS		(SNDRV_PCM_FMTBIT_FLOAT_LE | \
+				 SNDRV_PCM_FMTBIT_S32_LE | \
+				 SNDRV_PCM_FMTBIT_S24_LE | \
+				 SNDRV_PCM_FMTBIT_S16_LE | \
+				 SNDRV_PCM_FMTBIT_S8)
+#define ZHIHE_I2S_HDMI_FMTS	(SNDRV_PCM_FMTBIT_S24_LE | \
+				 SNDRV_PCM_FMTBIT_S16_LE)
+
+
+static inline bool zhihe_i2s_is_i2s3(enum zhihe_i2s_id id)
+{
+	return id >= ZHIHE_I2S3_8CH_SD0 && id <= ZHIHE_I2S3_8CH_SD3;
+}
+
+static inline bool zhihe_i2s_is_ap(enum zhihe_i2s_id id)
+{
+	return id == ZHIHE_AP_I2S;
+}
+
+static inline int zhihe_i2s3_sd_index(enum zhihe_i2s_id id)
+{
+	return id - ZHIHE_I2S3_8CH_SD0;
+}
+
+#define ZHIHE_IIS_48000_SRC_CLK	294912000
+#define	ZHIHE_IIS_44100_SRC_CLK	316108800
+
+#define IIS_MCLK_SEL_256	256
+#define IIS_MCLK_SEL_384	384
+
+#define I2S_IISEN	0x000 /* IIS Enable Register */
+#define I2S_FUNCMODE	0x004 /* IIS function mode */
+#define I2S_IISCNF_IN	0x008 /* IIS interface configuration in (on RX side) */
+#define I2S_FSSTA	0x00c /* IIS ATX audio input control/state register */
+#define I2S_IISCNF_OUT	0x010 /* IIS interface configuration in (on TX side) */
+#define I2S_FADTLR	0x014 /* IIS Fs auto detected Threshold level register */
+#define I2S_SCCR	0x018 /* Sample compress control register */
+#define I2S_TXFTLR	0x01c /* Transmit FIFO Threshold Level */
+#define I2S_RXFTLR	0x020 /* Receive FIFO Threshold Level */
+#define I2S_TXFLR	0x024 /* Transmit FIFO Level Register */
+#define I2S_RXFLR	0x028 /* Receive FIFO Level Register */
+#define I2S_SR		0x02c /* Status Register */
+#define I2S_IMR		0x030 /* Interrupt Mask Register */
