+enum con_cmd_type {
+	CON_CMD_IDLE = 0,
+	CON_CMD_READ,
+	CON_CMD_WRITE,
+	CON_CMD_BLOCK_RD,
+	CON_CMD_WP_LOCK,
+	CON_CMD_CP_LOCK,
+	CON_CMD_RP_LOCK,
+	CON_CMD_UP_LC,
+	CON_CMD_MAX,
+};
+
