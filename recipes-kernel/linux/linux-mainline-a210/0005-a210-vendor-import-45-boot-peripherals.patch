+	RPC_SET_BE16(&msg.rpc.regu_pwr_set.regu_id, 0, regu_id);
+	RPC_SET_BE16(&msg.rpc.regu_pwr_set.regu_id, 2, pwr_on);
+
+	return th1520_aon_call_rpc(ipc, &msg, &ack_msg, true);
+}
