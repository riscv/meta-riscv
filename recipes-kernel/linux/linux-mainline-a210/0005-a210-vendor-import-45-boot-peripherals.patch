+static int __maybe_unused th1520_efuse_runtime_suspend(struct device *dev)
+{
+	struct th1520_efuse_priv *priv = dev_get_drvdata(dev);
+	u32 data;
+	int ret;
+
+	dev_dbg(dev, "[%s,%d]efuse runtime power down\n", __func__, __LINE__);
+
+	if (!efuse_poweron_status_get(priv->base))
+		return 0;
+
+	data = readl(priv->base + CON);
+	data |= EFUSE_CON_POWER_MSK;
+	writel(data, priv->base + CON);
+
+	ret = efuse_idle_check(priv->base);
+
+	ret |= efuse_status_check(priv->base);
+
+	dev_dbg(dev, "[%s,%d] ret = %d, pd status: 0x%lx\n",
+		__func__, __LINE__, ret,
+		readl(priv->base + CON) & EFUSE_CON_POWER_MSK);
+
+	clk_disable_unprepare(priv->clk);
+
+	return ret;
+}
+
+static int __maybe_unused th1520_efuse_runtime_resume(struct device *dev)
+{
+	struct th1520_efuse_priv *priv = dev_get_drvdata(dev);
+	int ret = clk_prepare_enable(priv->clk);
+
+	if (ret) {
+		dev_err(dev, "%s: failed to get efuse clk\n", __func__);
+		return ret;
+	}
+
+	dev_dbg(dev, "[%s,%d]efuse runtime power on\n", __func__, __LINE__);
+
+	return efuse_poweron(priv->base);
+}
+
+static int __maybe_unused th1520_efuse_suspend(struct device *dev)
+{
+	u32 data;
+	int ret;
+	struct th1520_efuse_priv *priv = dev_get_drvdata(dev);
+
+	dev_dbg(dev, "[%s,%d]efuse suspend enter\n", __func__, __LINE__);
+
+	if (!efuse_poweron_status_get(priv->base))
+		return 0;
+
+	data = readl(priv->base + CON);
+	data |= EFUSE_CON_POWER_MSK;
+	writel(data, priv->base + CON);
+
+	ret = efuse_idle_check(priv->base);
+	ret |= efuse_status_check(priv->base);
+
+	dev_dbg(dev, "[%s,%d] ret = %d, pd status: 0x%lx\n",
+		__func__, __LINE__, ret,
+		readl(priv->base + CON) & EFUSE_CON_POWER_MSK);
+
+	clk_disable_unprepare(priv->clk);
+
+	return ret;
+}
+
+static int __maybe_unused th1520_efuse_resume(struct device *dev)
+{
+	struct th1520_efuse_priv *priv = dev_get_drvdata(dev);
+	int ret = clk_prepare_enable(priv->clk);
+
+	if (ret) {
+		dev_err(dev, "%s: failed to get efuse clk\n", __func__);
+		return ret;
+	}
+
+	dev_dbg(dev, "[%s,%d]efuse resume enter\n", __func__, __LINE__);
+
+	return efuse_poweron(priv->base);
+}
+
+static int th1520_efuse_probe(struct platform_device *pdev)
+{
+	int ret;
+	struct nvmem_device *nvmem;
+	struct nvmem_config config = {};
+	struct th1520_efuse_priv *priv;
+	struct device *dev = &pdev->dev;
+
+	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	priv->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(priv->base))
+		return PTR_ERR(priv->base);
+
+	/* optional clock, default open */
+	priv->clk = devm_clk_get(dev, "pclk");
+	if (IS_ERR_OR_NULL(priv->clk)) {
+		if (PTR_ERR(priv->clk) != -EPROBE_DEFER)
+			dev_err(&pdev->dev, "%s: failed to get efuse clk\n",
+				__func__);
+		return PTR_ERR(priv->clk);
+	}
+
+	ret = clk_prepare_enable(priv->clk);
+	if (ret) {
+		dev_err(dev, "%s: failed to enable efuse clk\n", __func__);
+		return ret;
+	}
+
+	priv->teesys_regs = syscon_regmap_lookup_by_phandle(dev->of_node,
+							    "xuantie,secsys");
+	if (IS_ERR(priv->teesys_regs)) {
+		dev_err(dev, "unable to find secsys registers\n");
+		return PTR_ERR(priv->teesys_regs);
+	}
+
+	priv->dev = dev;
+	dev_set_drvdata(dev, priv);
+
+	pm_runtime_enable(dev);
+	ret = pm_runtime_get_sync(dev);
+	if (ret < 0) {
+		dev_err(dev, "failed to get the efuse device(%d)\n", ret);
+		pm_runtime_put_noidle(dev);
+		return ret;
+	}
+
+	ret = sysfs_create_group(&dev->kobj, &dev_attr_efuse_sysfs_group);
+	if (ret) {
+		dev_err(dev, "failed to create efuse debug sysfs\n");
+		return ret;
+	}
+
+	config.name = "th1520-efuse";
+	config.read_only = false;
+	config.stride = 1;
+	config.word_size = 1;
+	/* the least read and write unit on the upper level */
+	config.reg_read = th1520_efuse_read;
+	config.reg_write = th1520_efuse_write;
+	config.size = TH1520_EFUSE_LIT_BLOCK_NUM *
+				TH1520_EFUSE_LIT_BLOCK_WIDTH +
+				TH1520_EFUSE_BIG_BLOCK_NUM *
+				TH1520_EFUSE_BIG_BLOCK_WIDTH;
+	config.priv = priv;
+	config.dev = dev;
+
+	nvmem = devm_nvmem_register(dev, &config);
+	if (IS_ERR(nvmem))
+		return PTR_ERR_OR_ZERO(nvmem);
+
+	pm_runtime_put_sync(dev);
+
+	dev_info(dev, "succeed to register th1520 efuse driver\n");
+
+	return 0;
+}
+
+static const struct dev_pm_ops efuse_runtime_pm_ops = {
+	SET_RUNTIME_PM_OPS(th1520_efuse_runtime_suspend,
+			   th1520_efuse_runtime_resume, NULL)
+	SET_SYSTEM_SLEEP_PM_OPS(th1520_efuse_suspend, th1520_efuse_resume)
+};
+
+static struct platform_driver th1520_efuse_driver = {
+	.probe	= th1520_efuse_probe,
+	.driver	= {
+		.name		= "th1520_efuse",
+		.of_match_table	= th1520_efuse_of_match,
+		.pm		= &efuse_runtime_pm_ops,
+	},
+};
+module_platform_driver(th1520_efuse_driver);
+
+MODULE_AUTHOR("Wei Liu <lw312886@linux.alibaba.com>");
+MODULE_DESCRIPTION("XuanTie TH1520 nvmem driver");
+MODULE_LICENSE("GPL");
