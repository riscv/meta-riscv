+	CMD_UPDATE_LC,
+	CMD_READ,
+	CMD_WRITE,
+	CMD_BLOCK_READ,
+	CMD_WP_LOCK,
+	CMD_CP_LOCK,
+	CMD_RP_LOCK,
+	CMD_KEY_TRAN,
+	CMD_KEY_MAX,
+};
