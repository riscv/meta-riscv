+	int ret;
+	u16 regu_id = (u16) rdev_get_id(reg);
+
+	hdr->svc = (uint8_t)TH1520_AON_RPC_SVC_PM;
+	hdr->func = (uint8_t)TH1520_AON_PM_FUNC_PWR_GET;
+	hdr->size = TH1520_AON_RPC_MSG_NUM;
