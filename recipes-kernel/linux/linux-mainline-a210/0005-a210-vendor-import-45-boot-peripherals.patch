+	RPC_SET_BE16(&msg.rpc.regu_pwr_get.regu_id, 0, regu_id);
+
+	ret = th1520_aon_call_rpc(th1520_aon_pmic_info.ipc_handle,
+				    &msg, &ack_msg, true);
+	if (ret < 0)
+		return ret;
+
+	RPC_GET_BE16(&ack_msg.regu_id, 2, &ack_msg.status);
+	return (int) ack_msg.status;
+}
